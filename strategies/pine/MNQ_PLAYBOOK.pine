//@version=5
// MNQ Playbook v6 (2026-10-25): NEWS / V4+ / D2 / TDP / Pinball / H2 on one shared daily risk budget.
// One engine, several charts: every chart runs ALL six strategies and the shared budget, so sizes and "budget left" match everywhere.
// The "Show on this chart" input only decides which strategies draw markers and fire alerts on that chart.
//   Chart 1  Open & News   : NEWS (8:30-9:30), V4+ (9:45-13:00), D2 (10:30)
//   Chart 2  Trend & Swing : TDP (10:30-12:00), H2 (10:30-15:00, half size), Pinball (10:30-15:00). All flat by 15:00, D2 by 13:15
// Use MNQ1! 1-minute, extended hours ON (needed for NEWS and the 8:29 price). Not an auto-trader: markers, sizes, alerts.
// Hover any marker for the full reason, entry, stop, target, size and risk.
indicator("MNQ Playbook v6", shorttitle="Playbook", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=300)

// ---------- chart group ----------
G_ALL = "All strategies"
G_1 = "Chart 1: Open & News (NEWS, V4+, D2)"
G_2 = "Chart 2: Trend & Swing (TDP, H2, Pinball)"
grp = input.string(G_1, "Show on this chart", options=[G_ALL, G_1, G_2], group="Chart")
g1 = grp != G_2
g2 = grp != G_1
showPD = input.bool(true, "Prior-day high / low / close lines", group="Chart")
showOR = input.bool(true, "Opening range (9:30-9:45) lines", group="Chart")
showPanel = input.bool(true, "Show panel", group="Chart")
panelIcon = input.bool(true, "Panel as one line, hover ⓘ for details", group="Chart")
showLog = input.bool(false, "Show last trades table", group="Chart")
logIcon = input.bool(true, "Last trades as one ⓘ line, hover for the table", group="Chart")
logToday = input.bool(true, "Last trades: today only (resets at the 18:00 session open)", group="Chart")
showCk = input.bool(true, "Strategy checklist (top left, hover each strategy)", group="Chart")
ckOpen = input.bool(false, "Checklist expanded (status words); off = compact one line", group="Chart")
showStats = input.bool(false, "Show results table (loaded bars)", group="Chart")
emaLen = input.int(20, "EMA length (0 = off)", group="Chart")
plot(emaLen > 0 ? ta.ema(close, emaLen) : na, "EMA", color=color.rgb(255, 0, 255), linewidth=1)

// ---------- strategy switches (switching one OFF removes it from the shared budget on this chart) ----------
useNW  = input.bool(false, "NEWS 8:30 reversion to the 8:29 price (CPI/PPI/NFP)", group="Strategies")
useV4  = input.bool(false, "V4+ opening-range retest with the daily trend", group="Strategies")
useD2  = input.bool(false, "D2 10:30 continuation", group="Strategies")
useTD  = input.bool(false, "TDP trend-day pullback", group="Strategies")
usePin = input.bool(false, "Momentum Pinball", group="Strategies")
useH2  = input.bool(false, "H2 trend-day pullbacks (half size)", group="Strategies")
useORB = input.bool(true, "ORB retest: 9:30-9:45 range, 5m close outside, retest, strong candle away", group="Strategies")
useIB  = input.bool(true, "Inside Bar signals (helper, any time of day)", group="Strategies")
orbQty = input.int(1, "ORB contracts (fixed)", minval=1, group="ORB")
orbTgt = input.float(2.0, "ORB target (R)", step=0.25, group="ORB")
orbLock = input.bool(true, "ORB: lock +1R once price reaches 1R", group="ORB")
orbEnd = input.int(780, "ORB last entry (minutes after midnight, 780 = 13:00)", group="ORB")
gapTh  = input.float(0.4, "V4+ gap threshold (x ADR)", group="V4+")
dirTh  = input.float(0.4, "V4+ first-15m threshold (x OR range)", group="V4+")
tgtR   = input.float(1.25, "V4+ target (R)", group="V4+")
v4BE   = input.bool(true, "V4+ stop to breakeven at +1R", group="V4+")
d2Th   = input.float(0.6, "D2 move at 10:30 (x ADR)", group="D2")
d2Flat = input.int(795, "D2 hard exit (minutes after midnight, 795 = 13:15)", group="D2")
tdEff  = input.float(0.6, "TDP first-hour efficiency min", group="TDP")
tdK    = input.float(0.33, "TDP pullback depth (x first-hour range)", group="TDP")
tdStop = input.float(0.4, "TDP stop (x ADR)", group="TDP")
tdTgt  = input.float(1.5, "TDP target (R)", group="TDP")
pinCap = input.int(180, "Pinball time cap (min after entry, 0 = off)", group="Pinball")
pinTgt = input.float(2.0, "Pinball target (R)", group="Pinball")
h2Th   = input.float(0.4, "H2 trend-day threshold at 10:30 (x ADR)", group="H2")
h2Tgt  = input.float(2.0, "H2 target (R)", group="H2")
h2Max  = input.int(3, "H2 max trades per day", group="H2")
nwStop = input.float(50, "NEWS stop (pts)", group="NEWS")
nwTgt  = input.float(50, "NEWS target (pts)", group="NEWS")
evStart= input.float(50000, "Eval starting balance ($)", group="Prop firm (update each morning)")
acct   = input.float(50000, "Balance at last close ($)", group="Prop firm (update each morning)")
peakEOD= input.float(50000, "Highest end-of-day balance so far ($)", group="Prop firm (update each morning)")
bestDay= input.float(0, "Best day profit so far ($)", group="Prop firm (update each morning)")
pfTgt  = input.float(3000, "Profit target ($)", group="Prop firm (update each morning)")
pfDD   = input.float(2000, "Trailing max loss, end of day ($)", group="Prop firm (update each morning)")
pfCons = input.float(0.4, "Consistency: best day max share of profit (Lucid Flex default 40%)", group="Prop firm (update each morning)")
mllLine= math.min(peakEOD - pfDD, evStart + 100)
frac   = input.float(0.65, "Risk = fraction of room", group="Sizing")
dayCap = input.float(1050, "Daily budget ($): open risk + today's losses, shared by all strategies", group="Sizing")
stopLos = input.int(3, "STOP the day after N losing trades (0 = off)", group="Sizing")
recIn  = input.float(400, "RECOVERY mode (1 MNQ only) when room above max-loss line is under ($)", group="Sizing")
recOut = input.float(700, "Back to normal sizing when room is at least ($)", group="Sizing")

// ---------- news calendar (yyyy-mm-dd HHMM NAME, comma separated, no spaces after commas) ----------
calStr = input.text_area("2026-09-04 0830 NFP,2026-09-10 0830 PPI,2026-09-11 0830 CPI,2026-09-16 1400 FOMC,2026-10-02 0830 NFP,2026-10-14 0830 CPI,2026-10-15 0830 PPI,2026-10-26 0830 Natl Activity,2026-10-27 0830 Durable Goods,2026-10-27 1000 Cons Confidence,2026-10-28 1400 FOMC,2026-10-28 1430 Powell presser,2026-10-29 0830 GDP + PCE,2026-10-30 0830 ECI,2026-10-30 0945 Chicago PMI,2026-11-03 1000 JOLTS,2026-11-06 0830 NFP,2026-11-10 0830 CPI,2026-11-13 0830 PPI,2026-12-01 1000 JOLTS,2026-12-04 0830 NFP,2026-12-09 1400 FOMC,2026-12-10 0830 CPI,2026-12-15 0830 PPI", "Economic calendar", group="News")
showSpike = input.bool(true, "Mark unexpected spikes", group="News")
spikeK = input.float(4.0, "Spike = 1m range >= K x median of last 30 bars", group="News")
spikeA = input.float(0.06, "... and >= this x ADR", group="News")

tz = "America/New_York"
mnt = hour(time, tz) * 60 + minute(time, tz)
mi  = minute(time, tz)
dom = dayofmonth(time, tz)
tick = syminfo.mintick
inRTH = mnt >= 570 and mnt < 960
newDay = inRTH and (not inRTH[1] or dom != dayofmonth(time[1], tz))

// colours
cNW = color.rgb(255, 193, 7)
cV4 = color.rgb(0, 150, 136)
cD2 = color.rgb(33, 150, 243)
cTD = color.rgb(233, 30, 99)
cPn = color.rgb(255, 120, 0)
cH2 = color.rgb(0, 188, 212)
cOB = color.rgb(255, 214, 0)

fmt(x) => str.tostring(x, "#.##")
// tags sit away from the candle with an arrow pointing at it
tagGap = ta.atr(14) * 2.5
callout(y, dir, gapK, txt, bg, fg, sz, tip) =>
    // dir +1: tag below, arrow up to y; dir -1: tag above, arrow down to y
    ly = y - dir * tagGap * gapK
    line.new(bar_index, ly, bar_index, y, color=color.new(bg, 0), style=line.style_arrow_right, width=1)
    label.new(bar_index, ly, txt, color=bg, textcolor=fg, style=dir > 0 ? label.style_label_up : label.style_label_down, size=sz, tooltip=tip)
usd(x) => (x < 0 ? "-$" : "$") + str.tostring(math.abs(math.round(x)), "#,###")
hhmm() => str.format_time(time, "HH:mm", tz)

// ---------- RTH daily context (prior completed day, no repaint) ----------
rthStats() =>
    tz2 = "America/New_York"
    m2 = hour(time, tz2) * 60 + minute(time, tz2)
    inR = m2 >= 570 and m2 < 960
    var float h = na
    var float l = na
    var float c = na
    var float pH = na
    var float pL = na
    var float pC = na
    var rngs = array.new_float()
    var cls = array.new_float()
    if inR
        h := na(h) ? high : math.max(h, high)
        l := na(l) ? low : math.min(l, low)
        c := close
    if m2 == 930 and not na(h)
        pH := h
        pL := l
        pC := c
        array.push(rngs, h - l)
        array.push(cls, c)
        h := na
        l := na
        c := na
    n = array.size(rngs)
    adr = n >= 10 ? array.avg(array.slice(rngs, n - 10, n)) : na
    nc = array.size(cls)
    sma = nc >= 20 ? array.avg(array.slice(cls, nc - 20, nc)) : na
    rsi = 50.0
    if nc >= 4
        c1 = array.get(cls, nc - 1) - array.get(cls, nc - 2)
        c2 = array.get(cls, nc - 2) - array.get(cls, nc - 3)
        c3 = array.get(cls, nc - 3) - array.get(cls, nc - 4)
        up = math.max(c1, 0) + math.max(c2, 0) + math.max(c3, 0)
        dn = math.max(-c1, 0) + math.max(-c2, 0) + math.max(-c3, 0)
        rsi := dn == 0 ? 100.0 : 100.0 - 100.0 / (1.0 + up / dn)
    [pH, pL, pC, adr, sma, rsi]
[pdh0, pdl0, pdc0, adr0, sma0, rsi0] = request.security(syminfo.tickerid, "30", rthStats(), lookahead=barmerge.lookahead_off)
var float pdh = na
var float pdl = na
var float pdc = na
var float adr10 = na
var float sma20 = na
var float rsi3 = na
if not inRTH or newDay
    pdh := pdh0
    pdl := pdl0
    pdc := pdc0
    adr10 := adr0
    sma20 := sma0
    rsi3 := rsi0
trendDir = pdc > sma20 ? 1 : -1

// ---------- prior-day levels (replaces the NT Look indicator) ----------
// Main set = full CME session (18:00-17:00 ET): PDH / PDL / PDC, solid lines with labels on the right.
// The RTH (9:30-16:00) high / low / close used by the strategies is drawn only when it differs by more than pdDiff points (thin dotted).
pdDiff = input.float(3.0, "Show RTH prior-day line only if it differs from the session level by more than (pts)", group="Chart")
sDay = dayofmonth(time + 6 * 3600000, tz)
sNew = ta.change(sDay) != 0
var float sCH = na
var float sCL = na
var float sCC = na
var float sPH = na
var float sPL = na
var float sPC = na
var int sStart = na
if sNew
    sPH := sCH
    sPL := sCL
    sPC := sCC
    sCH := na
    sCL := na
    sCC := na
    sStart := time
sCH := na(sCH) ? high : math.max(sCH, high)
sCL := na(sCL) ? low : math.min(sCL, low)
sCC := close
var line[] pdLines = array.new_line()
var label[] pdLabels = array.new_label()
pdBarMs = time - time[1]
pdLvl(float v, color c, string txt, string tip, string st, int w) =>
    x2 = time + 8 * pdBarMs
    ln = line.new(sStart, v, x2, v, xloc=xloc.bar_time, color=c, style=st, width=w)
    lb = label.new(x2, v, txt + " " + str.tostring(v, "#.00"), xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.black, 100), textcolor=c, size=size.small, tooltip=tip)
    [ln, lb]
if showPD and barstate.islast and not na(sPH)
    while array.size(pdLines) > 0
        line.delete(array.pop(pdLines))
    while array.size(pdLabels) > 0
        label.delete(array.pop(pdLabels))
    [a1, b1] = pdLvl(sPH, color.rgb(0, 200, 0), "PDH", "Prior session high (18:00-17:00 ET)", line.style_solid, 1)
    [a2, b2] = pdLvl(sPL, color.rgb(220, 20, 60), "PDL", "Prior session low (18:00-17:00 ET)", line.style_solid, 1)
    [a3, b3] = pdLvl(sPC, color.rgb(255, 165, 0), "PDC", "Prior session close (17:00 ET)", line.style_solid, 1)
    array.push(pdLines, a1), array.push(pdLines, a2), array.push(pdLines, a3)
    array.push(pdLabels, b1), array.push(pdLabels, b2), array.push(pdLabels, b3)
    if not na(pdh) and math.abs(pdh - sPH) > pdDiff
        [a4, b4] = pdLvl(pdh, color.new(color.green, 40), "RTH high", "Yesterday's 9:30-16:00 high (used by the strategies)", line.style_dotted, 1)
        array.push(pdLines, a4), array.push(pdLabels, b4)
    if not na(pdl) and math.abs(pdl - sPL) > pdDiff
        [a5, b5] = pdLvl(pdl, color.new(color.red, 40), "RTH low", "Yesterday's 9:30-16:00 low (used by the strategies)", line.style_dotted, 1)
        array.push(pdLines, a5), array.push(pdLabels, b5)
    if not na(pdc) and math.abs(pdc - sPC) > pdDiff
        [a6, b6] = pdLvl(pdc, color.new(color.orange, 40), "4pm close", "Yesterday's 16:00 close (gap and trend math)", line.style_dotted, 1)
        array.push(pdLines, a6), array.push(pdLabels, b6)

// ---------- today's calendar ----------
var int[] evM = array.new_int()
var string[] evN = array.new_string()
var string nextEv = "none listed"
var bool news830 = false
var bool cpiOrFomc = false
dChg = barstate.isfirst or dom != dayofmonth(time[1], tz)
if dChg
    dStr = str.format("{0,number,0000}-{1,number,00}-{2,number,00}", year(time, tz), month(time, tz), dom)
    dNum = year(time, tz) * 10000 + month(time, tz) * 100 + dom
    array.clear(evM)
    array.clear(evN)
    news830 := false
    cpiOrFomc := false
    nextEv := "none listed"
    bool found = false
    for p in str.split(calStr, ",")
        if str.length(p) >= 16
            pNum = str.tonumber(str.replace_all(str.substring(p, 0, 10), "-", ""))
            hm = str.tonumber(str.substring(p, 11, 15))
            nm = str.substring(p, 16)
            if str.startswith(p, dStr)
                array.push(evM, int(math.floor(hm / 100) * 60 + (hm - math.floor(hm / 100) * 100)))
                array.push(evN, nm)
                if hm == 830 and (nm == "CPI" or nm == "PPI" or nm == "NFP")
                    news830 := true
                if nm == "CPI" or nm == "FOMC"
                    cpiOrFomc := true
            if not found and pNum > dNum
                nextEv := nm + " " + str.substring(p, 5, 10) + " " + str.substring(p, 11, 13) + ":" + str.substring(p, 13, 15)
                found := true
evDesc(nm) =>
    nm == "CPI" ? "Consumer Price Index: monthly inflation in what households pay. The biggest scheduled mover for NQ. Hot = rates up = Nasdaq down. Our NEWS module trades the reversion to the 8:29 price." : nm == "PPI" ? "Producer Price Index: inflation in what businesses get paid (wholesale). Moves NQ less than CPI, but a surprise can still spike it. NEWS module trades it." : nm == "NFP" ? "Nonfarm Payrolls (jobs report): jobs added, unemployment rate, wages. Very volatile first minutes. NEWS module trades it; study: fade the 8:30-9:30 move at 9:30." : nm == "FOMC" ? "Fed rate decision and statement at 14:00. Study: the first 15 min move returns to the 13:59 price 87% of the time; never chase it; D2 is skipped on FOMC days." : str.contains(nm, "Powell") ? "Fed Chair press conference: often reverses or extends the 14:00 move. Stand aside until it settles." : str.contains(nm, "GDP") ? "GDP (economic growth) and PCE (the Fed's preferred inflation gauge) at 8:30. Study: no reliable edge, do not trade the release candle." : str.contains(nm, "Durable") ? "Durable Goods Orders: business spending on long-lasting goods. Usually a medium mover." : str.contains(nm, "Confidence") ? "Conference Board Consumer Confidence at 10:00. Medium mover." : nm == "JOLTS" ? "Job openings (JOLTS) at 10:00. Medium mover, no edge found." : nm == "ECI" ? "Employment Cost Index: wage inflation, quarterly. Medium mover." : str.contains(nm, "PMI") ? "Chicago PMI: regional manufacturing survey. Usually small." : str.contains(nm, "Activity") ? "Chicago Fed National Activity Index. Minor." : "Scheduled economic release."
todayEv() =>
    s = ""
    for k = 0 to array.size(evN) - 1
        if array.size(evN) > 0
            m0 = array.get(evM, k)
            s := s + (s == "" ? "" : ", ") + array.get(evN, k) + " " + str.format("{0,number,00}:{1,number,00}", math.floor(m0 / 60), m0 % 60)
    s
nearEvent(m, w) =>
    bool r = false
    if array.size(evM) > 0
        for k = 0 to array.size(evM) - 1
            if math.abs(m - array.get(evM, k)) <= w
                r := true
    r
// event marker at release time (all charts)
if array.size(evM) > 0
    for k = 0 to array.size(evM) - 1
        if mnt == array.get(evM, k) and mnt != nz(mnt[1], -1)
            line.new(bar_index, low, bar_index, high, extend=extend.both, color=color.new(color.red, 50), style=line.style_dotted)
            label.new(bar_index, high, array.get(evN, k), color=color.new(color.red, 15), textcolor=color.white, style=label.style_label_down, size=size.tiny, tooltip=array.get(evN, k) + " at " + hhmm() + " ET\n" + evDesc(array.get(evN, k)))

// ---------- day state ----------
var float rOpen = na
var float orH = na
var float orL = na
var float ibH = na
var float ibL = na
var int bias = 0
var bool biasSet = false
if newDay
    rOpen := open
    orH := high
    orL := low
    ibH := high
    ibL := low
    bias := 0
    biasSet := false
if inRTH and mnt < 585 and not newDay
    orH := math.max(orH, high)
    orL := math.min(orL, low)
if inRTH and mnt < 630 and not newDay
    ibH := math.max(ibH, high)
    ibL := math.min(ibL, low)
if inRTH and mnt >= 585 and not biasSet and not na(rOpen) and not na(adr10)
    gapA = (rOpen - pdc) / adr10
    odir = (close[1] - rOpen) / math.max(orH - orL, tick)
    bias := math.abs(gapA) >= gapTh ? (gapA > 0 ? 1 : -1) : math.abs(odir) >= dirTh ? (odir > 0 ? 1 : -1) : 0
    biasSet := true
plot(showOR and inRTH and mnt >= 585 ? orH : na, "OR high", color=color.new(color.yellow, 60), style=plot.style_linebr)
plot(showOR and inRTH and mnt >= 585 ? orL : na, "OR low", color=color.new(color.yellow, 60), style=plot.style_linebr)

// ---------- shared daily budget (resets at 8:00 ET, or at the first bar after it) ----------
var float rkNW = 0.0
var float rkV4 = 0.0
var float rkD2 = 0.0
var float rkTD = 0.0
var float rkPn = 0.0
var float rkH2 = 0.0
var float rkOB = 0.0
var float dayLoss = 0.0
var int[] dLos = array.from(0)
var bool dayStop = false
var bool recov = false
var string stopWhy = ""
var float dayPnl = 0.0
var int budDay = -1
if mnt >= 480 and mnt < 960 and budDay != dom
    budDay := dom
    rkNW := 0.0
    rkV4 := 0.0
    rkD2 := 0.0
    rkTD := 0.0
    rkPn := 0.0
    rkH2 := 0.0
    rkOB := 0.0
    dayLoss := 0.0
    dayPnl := 0.0
    array.set(dLos, 0, 0)
    dayStop := false
    stopWhy := ""
perC(riskPts) => riskPts * 2 + 0.5 + 4.74
usedNow() => rkNW + rkV4 + rkD2 + rkTD + rkPn + rkH2 + rkOB + dayLoss
sizeFor(riskPts, w) =>
    room = acct - mllLine
    used = usedNow()
    pc = perC(riskPts)
    budget = math.min(w * frac * room, frac * room - used, dayCap - used)
    r1 = (riskPts + 0.25 + 8) * 2 + 4.74
    avail = acct + dayPnl - mllLine - (used - dayLoss) - 100
    q = dayStop ? 0 : budget > 0 ? math.floor(budget / pc) : 0
    if not dayStop and q < 1 and w >= 1 and pc < 0.9 * (room - used) and pc < dayCap - used
        q := 1
    if recov
        q := not dayStop and r1 <= avail ? 1 : 0
    else
        q := math.min(q, math.max(0, math.floor(avail / r1)))
    math.max(0, q)
lossOf(q, pts) => pts < 0 ? q * (-pts * 2 + 4.74) : 0.0
pnlOf(q, pts) => q * (pts * 2 - 4.74)

// ---------- drawing helpers ----------
// entry: small tag "V4+ ▲ 4" (strategy, direction, contracts); hover for the full story. Zones: green to target, red to stop.
// order-panel presets: nearest saved bracket for this strategy (stop in points; target = R x stop)
pBk(nm) => nm == "NEWS" ? array.from(50.0) : nm == "H2" ? array.from(30.0) : nm == "V4+" ? array.from(80.0, 125.0, 190.0) : nm == "D2" ? array.from(160.0, 240.0, 360.0) : nm == "TDP" ? array.from(100.0, 165.0) : array.from(230.0)
pR(nm) => nm == "NEWS" ? 1.0 : nm == "H2" ? 2.0 : nm == "V4+" ? 1.25 : nm == "D2" ? 0.0 : nm == "TDP" ? 1.5 : 2.0
presetOf(nm, rp) =>
    bk = pBk(nm)
    best = array.get(bk, 0)
    for v in bk
        if math.abs(v - rp) < math.abs(best - rp)
            best := v
    best
entryTag(show, nm, side, e, s, t, q, exitRule, why, col) =>
    if show
        rp = math.abs(e - s)
        tgtLine = na(t) ? "Target: none, time exit" : "Target: " + fmt(t) + "  (" + fmt(math.abs(t - e)) + " pts · +" + usd(q * (math.abs(t - e) * 2 - 4.74)) + ")"
        pv = presetOf(nm, rp)
        pName = nm + " " + str.tostring(pv, "#")
        pLine = nm == "NEWS" ? "PRESET: none, type it by hand: SL 200 ticks · TP 200 ticks" : nm == "ORB" ? "BRACKET (type it): SL " + str.tostring(math.round(rp / tick)) + " ticks · TP " + str.tostring(math.round(math.abs(t - e) / tick)) + " ticks" : "PRESET: " + pName + "  (SL " + str.tostring(pv * 4, "#") + " ticks · " + (pR(nm) > 0 ? "TP " + str.tostring(pv * pR(nm) * 4, "#") + " ticks" : "no TP") + ")" + (math.abs(pv - rp) > 0.5 ? "\nExact stop is " + fmt(rp) + " pts: drag the SL line onto the red dotted line if you want it exact" : "")
        head = nm + (side > 0 ? " LONG" : " SHORT") + " · " + str.tostring(q) + " MNQ" + (q > 0 ? "" : (dayStop ? " · SKIP, STOP DAY" : recov ? " · SKIP, RECOVERY: risk too big for the room" : " · SKIP, budget full"))
        tip = head + "\n" + pLine + "\n――――――――――――\nEntry: " + fmt(e) + "  at " + hhmm() + "\nStop: " + fmt(s) + "  (" + fmt(rp) + " pts · risk " + usd(q * perC(rp)) + ")\n" + tgtLine + "\nBracket: SL " + str.tostring(math.round(rp / tick)) + " ticks · " + (na(t) ? "no TP (time exit)" : "TP " + str.tostring(math.round(math.abs(t - e) / tick)) + " ticks") + "\nExit: " + exitRule + "\nBudget left today: " + usd(math.max(0, dayCap - usedNow())) + "\n――――――――――――\nWhy\n• " + str.replace_all(why, " | ", "\n• ")
        callout(side > 0 ? low : high, side > 0 ? 1 : -1, 1.0, nm + (side > 0 ? " ▲ " : " ▼ ") + str.tostring(q) + (q > 0 and nm != "NEWS" and nm != "ORB" ? " · " + str.tostring(presetOf(nm, math.abs(e - s)), "#") : ""), q > 0 ? col : color.new(col, 60), color.white, size.small, tip)
    true
// while a trade is open: thin dotted stop (red) and target (green) lines; at the exit they are replaced by one line entry -> exit
zone(show, e, lvl, good) => show and not na(lvl) ? line.new(bar_index, lvl, bar_index + 1, lvl, color=color.new(good ? color.lime : color.red, 30), style=line.style_dotted, width=1) : line(na)
grow(b) =>
    if not na(b)
        line.set_x2(b, bar_index)
    true
exitTag(show, nm, side, x, pts, q, why, e, bS, bT) =>
    if show
        x1 = na(bS) ? bar_index : line.get_x1(bS)
        line.delete(bS)
        line.delete(bT)
        if q > 0
            line.new(x1, e, bar_index, x, color=color.new(pts >= 0 ? color.lime : color.red, 10), style=line.style_dashed, width=1)
            callout(x, side > 0 ? -1 : 1, 0.7, (pts >= 0 ? "✓ " : "✗ ") + fmt(pts), color.new(pts >= 0 ? color.teal : color.maroon, 20), color.white, size.tiny, nm + " EXIT · " + why + "\n――――――――――――\nResult: " + (pts >= 0 ? "+" : "") + fmt(pts) + " pts × " + str.tostring(q) + " MNQ = " + usd(pnlOf(q, pts)) + "\nExit: " + fmt(x) + "  at " + hhmm())
    true

// trade log (last 8 closed, all strategies)
var string[] lgD = array.new_string()
var string[] lgS = array.new_string()
var string[] lgX = array.new_string()
var float[] lgP = array.new_float()
if logToday and ta.change(time_tradingday) != 0
    array.clear(lgD)
    array.clear(lgS)
    array.clear(lgX)
    array.clear(lgP)
logTrade(nm, side, eT, why, pts) =>
    array.push(lgD, str.format_time(time, "MMM dd", tz))
    array.push(lgS, nm + (side > 0 ? " LONG " : " SHORT ") + eT)
    array.push(lgX, why + " " + hhmm())
    array.push(lgP, pts)
    if pts < 0
        array.set(dLos, 0, array.get(dLos, 0) + 1)
    if array.size(lgP) > 8
        array.shift(lgD)
        array.shift(lgS)
        array.shift(lgX)
        array.shift(lgP)
    true

// results counters
var float[] sPts = array.new_float(7, 0.0)
var int[] sN = array.new_int(7, 0)
var int[] sW = array.new_int(7, 0)
addRes(k, pts) =>
    array.set(sPts, k, array.get(sPts, k) + pts)
    array.set(sN, k, array.get(sN, k) + 1)
    array.set(sW, k, array.get(sW, k) + (pts > 0 ? 1 : 0))
    true

// ===================== NEWS: 8:30 reversion to the 8:29 price (CPI / PPI / NFP), 5m signals built from 1m =====================
// Fair price = close of the 8:29 candle. Signal on a 5m close from 8:30 to 9:29: candle toward the 8:29 price that is a displacement
// (bigger body than the previous candle, closes beyond its wick, previous candle opposite colour) or a break of structure
// (close beyond the latest 5m swing). Needs >= 0.8 x target of room. Entry next bar open. Stop/target 50/50. Max 4, stop after 3 losses. Flat 10:30.
var float nwF = na
var float[] nO = array.new_float()
var float[] nH = array.new_float()
var float[] nL = array.new_float()
var float[] nC = array.new_float()
var float nbO = na
var float nbH = na
var float nbL = na
var int nwPos = 0
var int nwPend = 0
var int nwN_ = 0
// ---------- RECOVERY mode: under recIn of room, 1 MNQ only, until room >= recOut ----------
roomNow = acct + dayPnl - mllLine
if not recov and roomNow < recIn
    recov := true
else if recov and roomNow >= recOut
    recov := false
// ---------- STOP DAY: hard stop, big warning ----------
if mnt >= 480 and mnt < 960 and budDay == dom and not dayStop
    nLos = array.get(dLos, 0)
    if dayLoss >= dayCap - 150
        dayStop := true
        stopWhy := "Daily loss budget used (" + usd(dayLoss) + " of " + usd(dayCap) + ")"
    else if stopLos > 0 and nLos >= stopLos
        dayStop := true
        stopWhy := str.tostring(nLos) + " losing trades today"
    else if acct - evStart + dayPnl >= math.max(pfTgt, math.max(bestDay, dayPnl) / pfCons)
        dayStop := true
        stopWhy := "Eval passed (target and 40% rule met). Protect it, no more trades"
if mnt >= 480 and mnt < 960 and budDay == dom and dayStop[1] == false and dayStop
    label.new(bar_index, high, "STOP", color=color.red, textcolor=color.white, style=label.style_label_down, size=size.large, tooltip="STOP DAY: " + stopWhy)
if not (mnt >= 480 and mnt < 960) and dayStop and mnt >= 960
    dayStop := false
    stopWhy := ""
bgcolor(dayStop and inRTH ? color.new(color.red, 85) : na, title="STOP day tint")
var table stopT = table.new(position.middle_center, 1, 2, bgcolor=color.new(#2a0000, 10), border_color=color.red, border_width=3, frame_color=color.red, frame_width=3)
if barstate.islast
    table.clear(stopT, 0, 0, 0, 1)
    showBan = dayStop or recov
    table.set_frame_color(stopT, showBan ? color.red : color.new(color.black, 100))
    table.set_border_color(stopT, showBan ? color.red : color.new(color.black, 100))
    table.set_bgcolor(stopT, showBan ? color.new(#2a0000, 10) : color.new(color.black, 100))
    table.set_frame_width(stopT, showBan ? 3 : 0)
    if dayStop
        table.cell(stopT, 0, 0, "STOP · NO MORE TRADES TODAY", text_color=color.white, text_size=size.huge)
        table.cell(stopT, 0, 1, stopWhy + "\nClose the platform. Tomorrow is a new day.", text_color=color.new(#ffb3b3, 0), text_size=size.large)
    else if recov
        openRk = usedNow() - dayLoss
        maxRisk = roomNow - openRk - 100
        dead = maxRisk < 60
        table.cell(stopT, 0, 0, dead ? "DEAD ZONE · NO SETUP FITS" : "RECOVERY · 1 MNQ ONLY", text_color=color.white, text_size=size.large, bgcolor=dead ? color.new(#5a0000, 0) : color.new(#7a4a00, 0))
        table.cell(stopT, 0, 1, "Room " + usd(roomNow) + " above the max-loss line · normal sizing back at " + usd(recOut) + "\n" + (dead ? "Nothing fits safely. Stop here; consider starting a new eval." : "Max risk per trade " + usd(maxRisk) + ". Take only signals the chart sizes at 1."), text_color=color.new(#ffe0b3, 0), text_size=size.normal, bgcolor=dead ? color.new(#5a0000, 0) : color.new(#7a4a00, 0))

var int nwLossRow = 0
var float nwE = na
var float nwS = na
var float nwT = na
var int nwQ = 0
var string nwET = ""
var line nwBT = na
var line nwBS = na
if dChg
    nwF := na
    array.clear(nO)
    array.clear(nH)
    array.clear(nL)
    array.clear(nC)
    nbO := na
    nwPos := 0
    nwPend := 0
    nwN_ := 0
    nwLossRow := 0
if useNW and news830 and mnt >= 360 and mnt < 640
    if mnt == 509
        nwF := close
        if g1
            line.new(bar_index, nwF, bar_index + 120, nwF, color=color.new(cNW, 20), style=line.style_dotted, width=2)
            label.new(bar_index, nwF, "8:29 price", color=color.new(cNW, 30), textcolor=color.black, style=label.style_label_right, size=size.tiny, tooltip="JJ Simon: on CPI/PPI/NFP days the price just before 8:30 is the fair price. After the spike, look for a 5m displacement or break of structure back toward it.")
    // manage
    if nwPos != 0
        grow(nwBT)
        grow(nwBS)
        hS = nwPos > 0 ? low <= nwS : high >= nwS
        hT = nwPos > 0 ? high >= nwT : low <= nwT
        x = hS ? nwS : hT ? nwT : mnt >= 630 ? close : na
        if not na(x)
            pts = (x - nwE) * nwPos
            addRes(0, pts)
            rkNW := 0.0
            dayLoss += lossOf(nwQ, pts)
            dayPnl += pnlOf(nwQ, pts)
            nwLossRow := pts < 0 ? nwLossRow + 1 : 0
            logTrade("NEWS", nwPos, nwET, hS ? "stop" : hT ? "target" : "10:30", pts)
            exitTag(g1, "NEWS", nwPos, x, pts, nwQ, hS ? "stop" : hT ? "target" : "10:30 time exit", nwE, nwBS, nwBT)
            if g1
                alert("NEWS exit " + fmt(pts) + " pts", alert.freq_once_per_bar)
            nwPos := 0
    // fill a pending signal at this bar's open
    if nwPend != 0 and nwPos == 0
        e = open + nwPend * tick
        dist = (nwF - e) * nwPend
        if dist >= 0.8 * nwTgt
            nwE := e
            nwS := e - nwPend * nwStop
            nwT := e + nwPend * nwTgt
            nwPos := nwPend
            nwN_ += 1
            q = sizeFor(nwStop, 1.0)
            nwQ := q
            nwET := hhmm()
            rkNW := q * perC(nwStop)
            entryTag(g1, "NEWS", nwPend, nwE, nwS, nwT, q, "target, stop or 10:30", "CPI/PPI/NFP day: price spiked away from the 8:29 price (" + fmt(nwF) + ") | 5m candle back toward it (displacement or break of structure) | " + fmt(dist) + " pts of room to the 8:29 price", cNW)
            nwBT := zone(g1, nwE, nwT, true)
            nwBS := zone(g1, nwE, nwS, false)
            if g1
                alert("NEWS " + (nwPend > 0 ? "LONG " : "SHORT ") + fmt(nwE) + " stop " + fmt(nwS) + " target " + fmt(nwT) + " size " + str.tostring(q) + " MNQ", alert.freq_once_per_bar)
        nwPend := 0
    // build 5m bars
    if na(nbO)
        nbO := open
        nbH := high
        nbL := low
    else
        nbH := math.max(nbH, high)
        nbL := math.min(nbL, low)
    if (mi + 1) % 5 == 0
        array.push(nO, nbO)
        array.push(nH, nbH)
        array.push(nL, nbL)
        array.push(nC, close)
        nbO := na
        k = array.size(nC) - 1
        st5 = mnt - 4
        if k >= 3 and st5 >= 510 and st5 < 570 and not na(nwF) and nwPos == 0 and nwN_ < 4 and nwLossRow < 3
            c = array.get(nC, k)
            o = array.get(nO, k)
            pc = array.get(nC, k - 1)
            po = array.get(nO, k - 1)
            ph = array.get(nH, k - 1)
            pl = array.get(nL, k - 1)
            s = c < nwF ? 1 : c > nwF ? -1 : 0
            col = c > o ? 1 : c < o ? -1 : 0
            if s != 0 and col == s
                disp = math.abs(c - o) > math.abs(pc - po) and (s > 0 ? c > ph : c < pl) and (pc - po) * s < 0
                float sw = na
                for j = k - 2 to math.max(1, k - 29)
                    if j + 1 <= k and j - 1 >= 0 and na(sw)
                        if s < 0 and array.get(nL, j) < array.get(nL, j - 1) and array.get(nL, j) < array.get(nL, j + 1)
                            sw := array.get(nL, j)
                        if s > 0 and array.get(nH, j) > array.get(nH, j - 1) and array.get(nH, j) > array.get(nH, j + 1)
                            sw := array.get(nH, j)
                bos = not na(sw) and (s < 0 ? (c < sw and pc >= sw) : (c > sw and pc <= sw))
                if disp or bos
                    nwPend := s

// ===================== V4+: opening-range retest with the daily trend =====================
var int dr = 0
var bool saw = false
var bool v4Done = false
var float pLvl = na
var float pStp = na
var int pSide = 0
var int pBar = na
var int v4Pos = 0
var float v4E = na
var float v4S = na
var float v4T = na
var float v4R = na
var int v4Q = 0
var bool v4AtBE = false
var string v4ET = ""
var line v4BT = na
var line v4BS = na
if newDay
    dr := 0
    saw := false
    v4Done := false
    pSide := 0
    v4Pos := 0
if useV4 and inRTH
    if v4Pos != 0
        grow(v4BT)
        grow(v4BS)
        hitS = v4Pos > 0 ? low <= v4S : high >= v4S
        hitT = v4Pos > 0 ? high >= v4T : low <= v4T
        xP = hitS ? v4S : hitT ? v4T : mnt >= 900 ? close : na
        if na(xP) and v4BE and not v4AtBE and (v4Pos > 0 ? high >= v4E + v4R : low <= v4E - v4R)
            v4S := v4E + v4Pos * 1.25
            v4AtBE := true
            rkV4 := 0.0
            if g1
                label.new(bar_index, v4S, "BE", color=color.new(color.gray, 30), textcolor=color.white, style=label.style_label_left, size=size.tiny, tooltip="V4+ reached +1R: stop moved to breakeven " + fmt(v4S) + ". Its risk is freed from the daily budget.")
                alert("V4+ +1R: move stop to breakeven " + fmt(v4S), alert.freq_once_per_bar)
        if not na(xP)
            pts = (xP - v4E) * v4Pos
            why = hitS ? (v4AtBE ? "breakeven" : "stop") : hitT ? "target" : "15:00"
            addRes(1, pts)
            rkV4 := 0.0
            dayLoss += lossOf(v4Q, pts)
            dayPnl += pnlOf(v4Q, pts)
            logTrade("V4+", v4Pos, v4ET, why, pts)
            exitTag(g1, "V4+", v4Pos, xP, pts, v4Q, why, v4E, v4BS, v4BT)
            if g1
                alert("V4+ exit " + why + " " + fmt(pts) + " pts", alert.freq_once_per_bar)
            v4Pos := 0
    if pSide != 0 and bar_index == pBar + 1 and v4Pos == 0 and not v4Done
        if mnt <= 780 and (pSide > 0 ? high >= pLvl : low <= pLvl)
            v4E := pSide > 0 ? math.max(open, pLvl) : math.min(open, pLvl)
            v4S := pStp
            r = math.abs(v4E - v4S)
            v4T := v4E + pSide * tgtR * r
            v4Pos := pSide
            v4Done := true
            v4R := r
            v4AtBE := false
            q = sizeFor(r, 1.0)
            v4Q := q
            v4ET := hhmm()
            rkV4 := q * perC(r)
            entryTag(g1, "V4+", pSide, v4E, v4S, v4T, q, "1.25R target · stop to breakeven at +1R · else 15:00", "Daily trend and today's bias agree (" + (pSide > 0 ? "UP" : "DOWN") + ") | Price broke the 9:30-9:45 range, then retested it | Strong candle: stop order just beyond it | Stop on the other side of the range", cV4)
            v4BT := zone(g1, v4E, v4T, true)
            v4BS := zone(g1, v4E, v4S, false)
            if g1
                alert("V4+ " + (pSide > 0 ? "LONG " : "SHORT ") + fmt(v4E) + " stop " + fmt(v4S) + " target " + fmt(v4T) + " size " + str.tostring(q) + " MNQ", alert.freq_once_per_bar)
            if pSide > 0 ? low <= v4S : high >= v4S
                pts = (v4S - v4E) * pSide
                addRes(1, pts)
                v4Pos := 0
                rkV4 := 0.0
                dayLoss += lossOf(v4Q, pts)
                dayPnl += pnlOf(v4Q, pts)
                logTrade("V4+", pSide, v4ET, "stop", pts)
                exitTag(g1, "V4+", pSide, v4S, pts, v4Q, "stop (same bar)", v4E, v4BS, v4BT)
        pSide := 0
    if not v4Done and v4Pos == 0 and biasSet and bias != 0 and bias == trendDir and mnt >= 585 and mnt <= 780
        closes5 = (mi + 1) % 5 == 0
        if closes5 and close > orH
            if dr != 1
                dr := 1
                saw := false
        else if closes5 and close < orL
            if dr != -1
                dr := -1
                saw := false
        inside = close <= orH and close >= orL
        if inside and dr != 0
            dr := 0
            saw := false
        if dr != 0
            touch = dr > 0 ? low <= orH : high >= orL
            if touch
                saw := true
            rg = high - low
            bull = close > open and rg > 0 and (close - low) >= 0.5 * rg and math.abs(close - open) >= 0.3 * rg
            bear = close < open and rg > 0 and (high - close) >= 0.5 * rg and math.abs(close - open) >= 0.3 * rg
            if saw and not inside and (dr > 0 ? bull : bear) and dr == bias
                pLvl := dr > 0 ? high + tick : low - tick
                stp0 = dr > 0 ? orL - tick : orH + tick
                if math.abs(pLvl - stp0) < 4
                    stp0 := pLvl - dr * 4
                pStp := stp0
                pSide := dr
                pBar := bar_index

// ===================== ORB retest: 9:30-9:45 range (tested 5y on MNQ 1m: PF 1.19, every year > 1.0, 1 trade a day max) =====================
// 1) a 5m candle CLOSES outside the range = armed on that side (a 5m close back inside cancels it)
// 2) price comes back to the range edge (within 10% of the range width) = retest
// 3) a strong 5m candle away from the range (body >= half the candle, right colour) = entry at its close
// Stop 1 tick beyond the OTHER side of the range. Target 2R. Once +1R is reached, stop locks +1R. Last entry 13:00, flat 15:55.
var float o5O = na
var float o5H = na
var float o5L = na
var int obArm = 0
var bool obTouch = false
var bool obDone = false
var int obPos = 0
var float obE = na
var float obS = na
var float obT = na
var float obR = na
var int obQ = 0
var bool obLock = false
var string obET = ""
var line obBT = na
var line obBS = na
var label obLbl = na
obSay(txt, col, tip) =>
    y = obArm > 0 ? orH : orL
    if na(obLbl)
        label.new(bar_index + 2, y, txt, color=color.new(col, 25), textcolor=color.black, style=label.style_label_left, size=size.small, tooltip=tip)
    else
        label.set_xy(obLbl, bar_index + 2, y)
        label.set_text(obLbl, txt)
        label.set_color(obLbl, color.new(col, 25))
        label.set_tooltip(obLbl, tip)
        obLbl
if newDay
    obArm := 0
    obTouch := false
    obDone := false
    obPos := 0
    o5O := na
    obLbl := na
if useORB and inRTH and mnt >= 585
    // manage the open ORB trade
    if obPos != 0
        grow(obBT)
        grow(obBS)
        hitS = obPos > 0 ? low <= obS : high >= obS
        hitT = obPos > 0 ? high >= obT : low <= obT
        xP = hitS ? obS : hitT ? obT : mnt >= 955 ? close : na
        if not na(xP)
            pts = (xP - obE) * obPos
            why = hitS ? (obLock ? "lock +1R" : "stop") : hitT ? "target" : "15:55"
            addRes(6, pts)
            rkOB := 0.0
            dayLoss += lossOf(obQ, pts)
            dayPnl += pnlOf(obQ, pts)
            logTrade("ORB", obPos, obET, why, pts)
            exitTag(g1, "ORB", obPos, xP, pts, obQ, why, obE, obBS, obBT)
            if g1
                alert("ORB exit " + why + " " + fmt(pts) + " pts", alert.freq_once_per_bar)
            obPos := 0
        else if orbLock and not obLock and (obPos > 0 ? high >= obE + obR : low <= obE - obR)
            obLock := true
            obS := obE + obPos * obR
            rkOB := 0.0
            if g1 and not na(obBS)
                line.set_y1(obBS, obS)
                line.set_y2(obBS, obS)
                line.set_color(obBS, color.new(color.lime, 30))
                label.new(bar_index, obS, "+1R lock", color=color.new(color.gray, 30), textcolor=color.white, style=label.style_label_left, size=size.tiny, tooltip="ORB reached +1R: move your stop to " + fmt(obS) + " (+1R locked). Target stays " + fmt(obT) + ".")
                alert("ORB +1R: move stop to " + fmt(obS), alert.freq_once_per_bar)
    // build the 5m candle from 1m bars
    if mi % 5 == 0 or na(o5O)
        o5O := open
        o5H := high
        o5L := low
    else
        o5H := math.max(o5H, high)
        o5L := math.min(o5L, low)
    if (mi + 1) % 5 == 0 and obPos == 0 and not obDone and mnt - 4 < orbEnd and not na(orH)
        W = orH - orL
        c5 = close
        if obArm == 0
            if c5 > orH or c5 < orL
                obArm := c5 > orH ? 1 : -1
                obTouch := false
                if g1
                    obLbl := obSay("ORB " + (obArm > 0 ? "▲" : "▼") + " armed · wait for retest", cOB, "5m closed " + (obArm > 0 ? "above the range high " + fmt(orH) : "below the range low " + fmt(orL)) + ".\nNext: price comes back to " + fmt(obArm > 0 ? orH : orL) + " (within " + fmt(0.1 * W) + " pts), then a strong 5m candle " + (obArm > 0 ? "up" : "down") + " = entry.\nA 5m close back inside the range cancels it.")
        else
            if obArm > 0 ? c5 < orH : c5 > orL
                if g1
                    obLbl := obSay("ORB · back inside, cancelled", color.gray, "A 5m candle closed back inside the 9:30-9:45 range. No trade until a new 5m close outside.")
                obArm := 0
                obTouch := false
            else
                if obArm > 0 ? o5L <= orH + 0.1 * W : o5H >= orL - 0.1 * W
                    if not obTouch and g1
                        obLbl := obSay("ORB " + (obArm > 0 ? "▲" : "▼") + " retest ✓ · wait for strong 5m", cOB, "Price retested the range edge " + fmt(obArm > 0 ? orH : orL) + ".\nEntry on the close of a strong 5m candle " + (obArm > 0 ? "UP (green, body at least half the candle)" : "DOWN (red, body at least half the candle)") + ".")
                    obTouch := true
                rg = o5H - o5L
                strong = rg > 0 and math.abs(c5 - o5O) >= 0.5 * rg and (obArm > 0 ? c5 > o5O : c5 < o5O)
                if obTouch and strong
                    side = obArm
                    obE := c5
                    obS := side > 0 ? orL - tick : orH + tick
                    obR := math.abs(obE - obS)
                    obT := obE + side * orbTgt * obR
                    obPos := side
                    obDone := true
                    obLock := false
                    obArm := 0
                    q = dayStop ? 0 : orbQty
                    obQ := q
                    obET := hhmm()
                    rkOB := q * perC(obR)
                    if not na(obLbl)
                        label.delete(obLbl)
                    entryTag(g1, "ORB", side, obE, obS, obT, q, str.tostring(orbTgt) + "R target · lock +1R at 1R · else 15:55", "5m close outside the 9:30-9:45 range (" + fmt(orL) + " - " + fmt(orH) + ") | Retest of the range edge | Strong 5m candle away from the range | Stop on the other side of the range", cOB)
                    obBT := zone(g1, obE, obT, true)
                    obBS := zone(g1, obE, obS, false)
                    if g1
                        alert("ORB " + (side > 0 ? "LONG " : "SHORT ") + fmt(obE) + " stop " + fmt(obS) + " target " + fmt(obT) + " size " + str.tostring(q) + " MNQ", alert.freq_once_per_bar)

// ===================== D2: 10:30 continuation =====================
var int d2Pos = 0
var float d2E = na
var float d2S = na
var float d2W8 = 1.0
var bool d2Done = false
var int d2Q = 0
var line d2BS = na
if newDay
    d2Pos := 0
    d2Done := false
if useD2 and inRTH
    if d2Pos != 0
        grow(d2BS)
        hit = d2Pos > 0 ? low <= d2S : high >= d2S
        xP = hit ? d2S : mnt >= d2Flat ? close : na
        if not na(xP)
            pts = (xP - d2E) * d2Pos
            addRes(2, pts)
            rkD2 := 0.0
            dayLoss += lossOf(d2Q, pts)
            dayPnl += pnlOf(d2Q, pts)
            logTrade("D2", d2Pos, "10:30", hit ? "stop" : "13:15", pts)
            exitTag(g1, "D2", d2Pos, xP, pts, d2Q, hit ? "stop" : "13:15 time exit", d2E, d2BS, line(na))
            if g1
                alert("D2 exit " + fmt(pts) + " pts", alert.freq_once_per_bar)
            d2Pos := 0
            d2Done := true
    if mnt == 629 and d2Pos == 0 and not d2Done and not na(adr10) and not cpiOrFomc
        mv = (close - rOpen) / adr10
        if math.abs(mv) >= d2Th
            s = mv > 0 ? 1 : -1
            d2E := close
            d2S := rOpen - s * tick
            d2Pos := s
            d2W8 := s == trendDir ? 1.0 : 0.5
            r = math.abs(d2E - d2S)
            q = sizeFor(r, d2W8)
            d2Q := q
            rkD2 := q * perC(r)
            entryTag(g1, "D2", s, d2E, d2S, float(na), q, "13:15 time exit, or stop", "At 10:30 price is " + fmt(math.abs(mv)) + " ADR " + (s > 0 ? "above" : "below") + " the open: continuation | Stop at the opening price" + (d2W8 < 1 ? " | HALF size: against the daily trend" : ""), cD2)
            d2BS := zone(g1, d2E, d2S, false)
            if g1
                alert("D2 " + (s > 0 ? "LONG " : "SHORT ") + fmt(d2E) + " stop " + fmt(d2S) + " exit 13:15 size " + str.tostring(q) + " MNQ", alert.freq_once_per_bar)

// ===================== TDP: trend-day pullback =====================
var int tdS = 0
var float tdExt = na
var float tdFhr = na
var int tdPos = 0
var bool tdDone = false
var float tdE = na
var float tdSt = na
var float tdT = na
var int tdQ = 0
var string tdET = ""
var line tdLn = na
var line tdBT = na
var line tdBS = na
if newDay
    tdS := 0
    tdPos := 0
    tdDone := false
if useTD and inRTH
    if tdPos != 0
        grow(tdBT)
        grow(tdBS)
        hS3 = tdPos > 0 ? low <= tdSt : high >= tdSt
        hT3 = tdPos > 0 ? high >= tdT : low <= tdT
        x3 = hS3 ? tdSt : hT3 ? tdT : mnt >= 900 ? close : na
        if not na(x3)
            p3 = (x3 - tdE) * tdPos
            addRes(3, p3)
            rkTD := 0.0
            dayLoss += lossOf(tdQ, p3)
            dayPnl += pnlOf(tdQ, p3)
            logTrade("TDP", tdPos, tdET, hS3 ? "stop" : hT3 ? "target" : "15:00", p3)
            exitTag(g2, "TDP", tdPos, x3, p3, tdQ, hS3 ? "stop" : hT3 ? "target" : "15:00", tdE, tdBS, tdBT)
            if g2
                alert("TDP exit " + fmt(p3) + " pts", alert.freq_once_per_bar)
            tdPos := 0
    if mnt == 629 and not na(adr10) and not na(rOpen)
        fhr = ibH - ibL
        eff = fhr > 0 ? math.abs(close - rOpen) / fhr : 0.0
        sd = close > rOpen ? 1 : -1
        outside = sd > 0 ? close > pdh : close < pdl
        if eff >= tdEff and outside
            tdS := sd
            tdFhr := fhr
            tdExt := sd > 0 ? ibH : ibL
            if g2
                callout(sd > 0 ? high : low, sd > 0 ? -1 : 1, 0.7, "TDP armed", color.new(cTD, 50), color.white, size.tiny, "Trend day " + (sd > 0 ? "UP" : "DOWN") + ": first hour moved " + str.tostring(math.round(eff * 100)) + "% efficiently and price is outside the prior-day range. Limit order waits on the dashed line until 12:00.")
                alert("TDP armed: " + (sd > 0 ? "buy" : "sell") + " limit " + fmt(tdExt - sd * tdK * fhr) + " until 12:00", alert.freq_once_per_bar)
    if tdS != 0 and tdPos == 0 and not tdDone and mnt >= 630 and mnt < 720
        lvl3 = tdExt - tdS * tdK * tdFhr
        if tdS > 0 ? low <= lvl3 - tick : high >= lvl3 + tick
            line.delete(tdLn)
            tdE := tdS > 0 ? math.min(open, lvl3) : math.max(open, lvl3)
            tdSt := tdE - tdS * math.max(10.0, tdStop * adr10)
            r3 = math.abs(tdE - tdSt)
            tdT := tdE + tdS * tdTgt * r3
            tdPos := tdS
            tdDone := true
            q3 = sizeFor(r3, 1.0)
            tdQ := q3
            tdET := hhmm()
            rkTD := q3 * perC(r3)
            entryTag(g2, "TDP", tdS, tdE, tdSt, tdT, q3, "1.5R target, else 15:00", "Trend day " + (tdS > 0 ? "UP" : "DOWN") + ": first hour clean and outside the prior-day range | Pullback of 1/3 of the first-hour range from the day's " + (tdS > 0 ? "high" : "low") + " | Stop 0.4 x ADR", cTD)
            tdBT := zone(g2, tdE, tdT, true)
            tdBS := zone(g2, tdE, tdSt, false)
            if g2
                alert("TDP " + (tdS > 0 ? "LONG " : "SHORT ") + fmt(tdE) + " stop " + fmt(tdSt) + " target " + fmt(tdT) + " size " + str.tostring(q3) + " MNQ", alert.freq_once_per_bar)
            if tdS > 0 ? low <= tdSt : high >= tdSt
                p3 = (tdSt - tdE) * tdS
                addRes(3, p3)
                tdPos := 0
                rkTD := 0.0
                dayLoss += lossOf(tdQ, p3)
                dayPnl += pnlOf(tdQ, p3)
                logTrade("TDP", tdS, tdET, "stop", p3)
                exitTag(g2, "TDP", tdS, tdSt, p3, tdQ, "stop (same bar)", tdE, tdBS, tdBT)
        else
            tdExt := tdS > 0 ? math.max(tdExt, high) : math.min(tdExt, low)
            line.delete(tdLn)
            if g2
                tdLn := line.new(bar_index - 1, tdExt - tdS * tdK * tdFhr, bar_index + 3, tdExt - tdS * tdK * tdFhr, color=cTD, style=line.style_dashed)
    if tdS != 0 and mnt == 720 and not tdDone
        line.delete(tdLn)

// ===================== Momentum Pinball =====================
var int pnPos = 0
var float pnE = na
var float pnS = na
var float pnT = na
var line pnBT = na
var bool pnDone = false
var int pnQ = 0
var int pnT0 = 0
var string pnET = ""
var line pnBS = na
if newDay
    pnPos := 0
    pnDone := false
pinSide = rsi3 < 30 and trendDir > 0 ? 1 : rsi3 > 70 and trendDir < 0 ? -1 : 0
if usePin and inRTH
    if pnPos != 0
        grow(pnBS)
        grow(pnBT)
        hit = pnPos > 0 ? low <= pnS : high >= pnS
        hitT = not hit and (pnPos > 0 ? high >= pnT : low <= pnT)
        capHit = pinCap > 0 and mnt >= pnT0 + pinCap
        xP = hit ? pnS : hitT ? pnT : (mnt >= 900 or capHit) ? close : na
        if not na(xP)
            pts = (xP - pnE) * pnPos
            addRes(4, pts)
            rkPn := 0.0
            dayLoss += lossOf(pnQ, pts)
            dayPnl += pnlOf(pnQ, pts)
            logTrade("PIN", pnPos, pnET, hit ? "stop" : hitT ? "target" : capHit ? "3h cap" : "15:00", pts)
            exitTag(g2, "PIN", pnPos, xP, pts, pnQ, hit ? "stop" : hitT ? "target" : capHit ? "3h time cap" : "15:00", pnE, pnBS, pnBT)
            if g2
                alert("PINBALL exit " + fmt(pts) + " pts", alert.freq_once_per_bar)
            pnPos := 0
    if not pnDone and pnPos == 0 and pinSide != 0 and mnt >= 630 and mnt <= 900
        lvl = pinSide > 0 ? ibH + tick : ibL - tick
        if pinSide > 0 ? high >= lvl : low <= lvl
            pnE := pinSide > 0 ? math.max(open, lvl) : math.min(open, lvl)
            pnS := pinSide > 0 ? ibL - tick : ibH + tick
            pnPos := pinSide
            pnDone := true
            pnT0 := mnt
            r = math.abs(pnE - pnS)
            pnT := pnE + pinSide * pinTgt * r
            q = sizeFor(r, 1.0)
            pnQ := q
            pnET := hhmm()
            rkPn := q * perC(r)
            entryTag(g2, "PIN", pinSide, pnE, pnS, pnT, q, "2R target, 3h after entry, or 15:00", "3-day RSI " + fmt(rsi3) + (pinSide > 0 ? " (oversold)" : " (overbought)") + " with the daily trend " + (trendDir > 0 ? "UP" : "DOWN") + " | Price broke the first-hour " + (pinSide > 0 ? "high" : "low") + " | Stop on the other side of the first hour", cPn)
            pnBS := zone(g2, pnE, pnS, false)
            pnBT := zone(g2, pnE, pnT, true)
            if g2
                alert("PINBALL " + (pinSide > 0 ? "LONG " : "SHORT ") + fmt(pnE) + " stop " + fmt(pnS) + " size " + str.tostring(q) + " MNQ", alert.freq_once_per_bar)
            if pinSide > 0 ? low <= pnS : high >= pnS
                pts = (pnS - pnE) * pinSide
                addRes(4, pts)
                pnPos := 0
                rkPn := 0.0
                dayLoss += lossOf(pnQ, pts)
                dayPnl += pnlOf(pnQ, pts)
                logTrade("PIN", pinSide, pnET, "stop", pts)
                exitTag(g2, "PIN", pinSide, pnS, pts, pnQ, "stop (same bar)", pnE, pnBS, pnBT)

// ===================== H2: second-entry pullbacks on trend days (half size) =====================
var float[] bH = array.new_float()
var float[] bL = array.new_float()
var float[] bC = array.new_float()
var float[] bE = array.new_float()
var float bO_ = na
var float bH_ = na
var float bL_ = na
var float twSum = 0.0
var int twN = 0
var float e5 = na
var int tdDir = 0
var int h2Pos = 0
var int h2N_ = 0
var bool h2Pend = false
var int h2PSide = 0
var float h2PStp = na
var float h2E = na
var float h2S = na
var float h2T = na
var int h2Q = 0
var string h2ET = ""
var line h2BT = na
var line h2BS = na
if newDay
    array.clear(bH)
    array.clear(bL)
    array.clear(bC)
    array.clear(bE)
    bO_ := na
    twSum := 0.0
    twN := 0
    e5 := na
    tdDir := 0
    h2Pos := 0
    h2N_ := 0
    h2Pend := false
if useH2 and inRTH
    if mnt == 629 and not na(adr10) and not na(rOpen)
        mv2 = (close - rOpen) / adr10
        tdDir := math.abs(mv2) >= h2Th ? (mv2 > 0 ? 1 : -1) : 0
    if h2Pend and h2Pos == 0
        h2E := open
        h2S := h2PStp
        r2 = math.abs(h2E - h2S)
        if (h2PSide > 0 and h2S < h2E) or (h2PSide < 0 and h2S > h2E)
            h2T := h2E + h2PSide * h2Tgt * r2
            h2Pos := h2PSide
            h2N_ += 1
            q2 = sizeFor(r2, 0.5)
            h2Q := q2
            h2ET := hhmm()
            rkH2 := q2 * perC(r2)
            entryTag(g2, "H2", h2PSide, h2E, h2S, h2T, q2, "2R target, else 15:00", "Trend day: moved >= " + fmt(h2Th) + " ADR by 10:30 | 5m pullback after a new " + (h2PSide > 0 ? "high" : "low") + " | 5m close back through the prior bar (second entry) | HALF size", cH2)
            h2BT := zone(g2, h2E, h2T, true)
            h2BS := zone(g2, h2E, h2S, false)
            if g2
                alert("H2 " + (h2PSide > 0 ? "LONG " : "SHORT ") + fmt(h2E) + " stop " + fmt(h2S) + " target " + fmt(h2T) + " size " + str.tostring(q2) + " MNQ", alert.freq_once_per_bar)
        h2Pend := false
    if h2Pos != 0
        grow(h2BT)
        grow(h2BS)
        hS2 = h2Pos > 0 ? low <= h2S : high >= h2S
        hT2 = h2Pos > 0 ? high >= h2T : low <= h2T
        x2 = hS2 ? h2S : hT2 ? h2T : mnt >= 900 ? close : na
        if not na(x2)
            p2 = (x2 - h2E) * h2Pos
            addRes(5, p2)
            rkH2 := 0.0
            dayLoss += lossOf(h2Q, p2)
            dayPnl += pnlOf(h2Q, p2)
            logTrade("H2", h2Pos, h2ET, hS2 ? "stop" : hT2 ? "target" : "15:00", p2)
            exitTag(g2, "H2", h2Pos, x2, p2, h2Q, hS2 ? "stop" : hT2 ? "target" : "15:00", h2E, h2BS, h2BT)
            if g2
                alert("H2 exit " + fmt(p2) + " pts", alert.freq_once_per_bar)
            h2Pos := 0
    if na(bO_)
        bO_ := open
        bH_ := high
        bL_ := low
    else
        bH_ := math.max(bH_, high)
        bL_ := math.min(bL_, low)
    if (mi + 1) % 5 == 0
        c5 = close
        o5 = bO_
        array.push(bH, bH_)
        array.push(bL, bL_)
        array.push(bC, c5)
        twSum += (bH_ + bL_ + c5) / 3
        twN += 1
        e5 := na(e5) ? c5 : e5 + 2.0 / 21.0 * (c5 - e5)
        array.push(bE, e5)
        bO_ := na
        k = array.size(bC) - 1
        mclose = mnt + 1
        if k >= 8 and mclose >= 630 and mclose <= 900 and tdDir != 0 and tdDir == trendDir and h2Pos == 0 and not h2Pend and h2N_ < h2Max
            tw = twSum / twN
            upT = c5 > tw and e5 > array.get(bE, k - 3)
            dnT = c5 < tw and e5 < array.get(bE, k - 3)
            hh = array.max(array.slice(bH, 0, k - 2))
            ll = array.min(array.slice(bL, 0, k - 2))
            rh = array.max(array.slice(bH, k - 8, k - 2))
            rl = array.min(array.slice(bL, k - 8, k - 2))
            c1 = array.get(bC, k - 1)
            c2 = array.get(bC, k - 2)
            h1 = array.get(bH, k - 1)
            l1 = array.get(bL, k - 1)
            sg = 0
            float st2 = na
            if tdDir > 0 and upT and rh >= hh and c1 < c2 and c5 > h1 and c5 > o5
                sg := 1
                st2 := array.min(array.slice(bL, k - 3, k + 1)) - tick
            else if tdDir < 0 and dnT and rl <= ll and c1 > c2 and c5 < l1 and c5 < o5
                sg := -1
                st2 := array.max(array.slice(bH, k - 3, k + 1)) + tick
            if sg != 0
                rr = math.abs(c5 - st2)
                if rr >= 6 and rr <= 0.25 * adr10
                    h2Pend := true
                    h2PSide := sg
                    h2PStp := st2

// ---------- unexpected spike marker (no trade; our trend trades did better when spikes happened: hold to plan) ----------
var string lastSpike = "none today"
if dChg
    lastSpike := "none today"
rg1 = high - low
med30 = ta.median(rg1, 30)[1]
isSpike = inRTH and mnt >= 575 and not na(adr10) and rg1 >= spikeK * med30 and rg1 >= spikeA * adr10 and math.abs(close - open) >= 0.5 * rg1 and not nearEvent(mnt, 5)
if showSpike and isSpike
    lastSpike := hhmm() + (close > open ? " up " : " down ") + fmt(rg1) + " pts"
    label.new(bar_index, close > open ? high : low, "⚡", color=color.new(color.black, 100), textcolor=color.yellow, style=close > open ? label.style_label_down : label.style_label_up, size=size.small, tooltip="Unexpected spike (no scheduled release): " + fmt(rg1) + " pts in 1 minute. Not a trade signal. Tested 2022-2026: our trades held through spikes did better (PF 2.2 vs 1.4), so stick to the plan, no early exits.")

// ---------- panel ----------
openList() =>
    s = ""
    s := s + (nwPos != 0 ? "NEWS " + str.tostring(nwQ) + " " : "")
    s := s + (v4Pos != 0 ? "V4+ " + str.tostring(v4Q) + (v4AtBE ? " (BE) " : " ") : "")
    s := s + (d2Pos != 0 ? "D2 " + str.tostring(d2Q) + " " : "")
    s := s + (tdPos != 0 ? "TDP " + str.tostring(tdQ) + " " : "")
    s := s + (pnPos != 0 ? "PIN " + str.tostring(pnQ) + " " : "")
    s := s + (h2Pos != 0 ? "H2 " + str.tostring(h2Q) + " " : "")
    s == "" ? "flat" : s + "MNQ"
var table pn = table.new(position.top_right, 6, 10, bgcolor=color.new(#131722, 0), border_color=color.new(color.gray, 70), border_width=1, frame_color=color.new(color.gray, 50), frame_width=1)
if showPanel and barstate.islast
    tc = color.white
    dim = color.new(color.silver, 0)
    left = dayCap - usedNow()
    prof = acct - evStart + dayPnl
    best = math.max(bestDay, dayPnl)
    need = math.max(pfTgt, best / pfCons)
    room = acct + dayPnl - mllLine
    tev = todayEv()
    setups = grp != G_2 ? ((news830 ? "NEWS day · " : "") + (v4Done ? "V4+ done" : bias != 0 and bias == trendDir ? "V4+ watching retest" : "V4+ off today") + " · D2 at 10:30") : ((tdS != 0 and not tdDone and mnt < 720 ? "TDP armed " + (tdS > 0 ? "LONG" : "SHORT") : "TDP " + (tdDone ? "done" : "not armed")) + " · PIN " + (pinSide > 0 ? "LONG setup" : pinSide < 0 ? "SHORT setup" : "none") + " · H2 " + (tdDir != 0 ? "trend day" : "off"))
    labs = array.from("Showing", "Context", "Budget", "Open (all charts)", "Today P&L", "Setups", "News", "Spike", "Eval", "Max-loss line")
    vals = array.from(grp == G_ALL ? "all strategies" : grp == G_1 ? "Chart 1: NEWS · V4+ · D2" : "Chart 2: TDP · H2 · PIN", "trend " + (trendDir > 0 ? "UP" : "DOWN") + " · bias " + (not biasSet ? "at 9:45" : bias == 0 ? "none" : bias > 0 ? "LONG" : "SHORT") + " · ADR " + str.tostring(math.round(nz(adr10))), usd(usedNow()) + " in use · " + usd(math.max(0, left)) + " left of " + usd(dayCap), openList(), usd(dayPnl), setups, (tev == "" ? "none today" : "today " + tev) + " · next " + nextEv, lastSpike, usd(prof) + " of " + usd(need) + (need > pfTgt ? " (best day " + usd(best) + ", 50% rule)" : "") + (prof >= need ? " · TARGET MET" : " · " + usd(need - prof) + " to go"), usd(mllLine) + " · room " + usd(room))
    tip = ""
    for k = 0 to 9
        tip := tip + array.get(labs, k) + ": " + array.get(vals, k) + (k < 9 ? "\n" : "")
    if panelIcon
        table.clear(pn, 0, 0, 5, 0)
        table.cell(pn, 0, 0, "ⓘ PLAYBOOK", text_color=color.yellow, text_size=size.normal, text_halign=text.align_left, tooltip=tip)
        table.cell(pn, 1, 0, "Budget " + usd(math.max(0, left)) + " left", text_color=left < 200 ? color.orange : tc, text_size=size.normal, tooltip=tip)
        table.cell(pn, 2, 0, "Today " + (dayPnl > 0 ? "+" : "") + usd(dayPnl), text_color=dayPnl > 0 ? color.lime : dayPnl < 0 ? color.red : tc, text_size=size.normal, tooltip=tip)
        table.cell(pn, 3, 0, prof >= need ? "TARGET MET" : "Eval " + usd(need - prof) + " to go", text_color=prof >= need ? color.lime : room < 800 ? color.orange : tc, text_size=size.normal, tooltip=tip)
        if openList() != "flat"
            table.cell(pn, 4, 0, "OPEN " + openList(), text_color=color.aqua, text_size=size.normal, tooltip=tip)
        if tev != ""
            table.cell(pn, 5, 0, "NEWS " + tev, text_color=color.orange, text_size=size.normal, tooltip=tip)
    else
        for k = 0 to 9
            table.cell(pn, 0, k, array.get(labs, k), text_color=k == 0 ? color.yellow : dim, text_size=size.normal, text_halign=text.align_left)
            table.cell(pn, 1, k, array.get(vals, k), text_color=k == 0 ? color.yellow : tc, text_size=size.normal, text_halign=text.align_left)

// ---------- results table (optional) ----------
var table tb = table.new(position.bottom_right, 3, 7, bgcolor=color.new(#131722, 10), border_color=color.new(color.gray, 80), border_width=1)
if showStats and barstate.islast
    names = array.from("NEWS", "V4+", "D2", "TDP", "Pinball", "H2")
    table.cell(tb, 0, 0, "Loaded bars", text_color=color.yellow, text_size=size.small)
    table.cell(tb, 1, 0, "trades / wins", text_color=color.yellow, text_size=size.small)
    table.cell(tb, 2, 0, "pts (1 MNQ $)", text_color=color.yellow, text_size=size.small)
    for k = 0 to 5
        pv = array.get(sPts, k)
        table.cell(tb, 0, k + 1, array.get(names, k), text_color=color.white, text_size=size.small)
        table.cell(tb, 1, k + 1, str.tostring(array.get(sN, k)) + " / " + str.tostring(array.get(sW, k)), text_color=color.white, text_size=size.small)
        table.cell(tb, 2, k + 1, fmt(pv) + " (" + usd(pv * 2) + ")", text_color=pv >= 0 ? color.lime : color.red, text_size=size.small)

// ---------- last trades (optional) ----------
var table lt = table.new(position.bottom_left, 6, 9, bgcolor=color.new(#131722, 0), border_color=color.new(color.gray, 70), border_width=1)
if showLog and barstate.islast
    nL = array.size(lgP)
    if logIcon
        table.clear(lt, 0, 0, 5, 0)
        ttip = (logToday ? "TODAY'S SIGNALS" : "LAST TRADES") + " (1 MNQ, newest first; your real fills are in the Tradovate panel)\n"
        for i = 0 to 7
            if i < nL
                j = nL - 1 - i
                pv = array.get(lgP, j)
                ttip := ttip + "\n" + array.get(lgD, j) + "  " + array.get(lgS, j) + "  →  " + array.get(lgX, j) + "   " + (pv >= 0 ? "+" : "") + fmt(pv) + " pts (" + (pv >= 0 ? "+" : "") + usd(pv * 2) + ")"
        if nL == 0
            ttip := ttip + "\nnone yet today"
        table.cell(lt, 0, 0, "ⓘ TRADES", text_color=color.yellow, text_size=size.normal, text_halign=text.align_left, tooltip=ttip)
        if nL == 0
            table.cell(lt, 1, 0, "none yet", text_color=color.silver, text_size=size.normal, tooltip=ttip)
        for i = 0 to 4
            if i < nL
                j = nL - 1 - i
                pv = array.get(lgP, j)
                table.cell(lt, 1 + i, 0, (pv >= 0 ? "+" : "") + fmt(pv), text_color=pv >= 0 ? color.lime : color.red, text_size=size.normal, tooltip=array.get(lgD, j) + "  " + array.get(lgS, j) + "  →  " + array.get(lgX, j) + "\n" + (pv >= 0 ? "+" : "") + fmt(pv) + " pts = " + (pv >= 0 ? "+" : "") + usd(pv * 2) + " per MNQ")
    else
        table.cell(lt, 0, 0, "Last trades", text_color=color.yellow, text_size=size.normal)
        table.cell(lt, 1, 0, "strategy / entry", text_color=color.yellow, text_size=size.normal)
        table.cell(lt, 2, 0, "exit", text_color=color.yellow, text_size=size.normal)
        table.cell(lt, 3, 0, "pts (1 MNQ $)", text_color=color.yellow, text_size=size.normal)
        if nL == 0
            table.cell(lt, 0, 1, "none yet today", text_color=color.white, text_size=size.normal)
        for i = 0 to 7
            if i < nL
                j = nL - 1 - i
                pv = array.get(lgP, j)
                table.cell(lt, 0, i + 1, array.get(lgD, j), text_color=color.white, text_size=size.normal)
                table.cell(lt, 1, i + 1, array.get(lgS, j), text_color=color.white, text_size=size.normal)
                table.cell(lt, 2, i + 1, array.get(lgX, j), text_color=color.white, text_size=size.normal)
                table.cell(lt, 3, i + 1, fmt(pv) + " (" + usd(pv * 2) + ")", text_color=pv >= 0 ? color.lime : color.red, text_size=size.normal)

// ---------- strategy checklist (middle left): one colored cell per strategy, hover for the boxes ----------
ck(b) => b ? "✓ " : "✗ "
wt(b, w) => b ? "… " : w
var table ckT = table.new(position.top_left, 8, 5, border_color=color.new(color.gray, 70), border_width=0)
if showCk and barstate.islast
    table.clear(ckT, 0, 0, 7, 4)
    for r = 0 to 3
        table.cell(ckT, 0, r, " ", text_size=size.normal, bgcolor=color.new(color.black, 100))
    table.cell(ckT, 0, 4, ckOpen ? "ⓘ CHECKLIST" : "ⓘ", text_color=color.yellow, text_size=size.normal, bgcolor=color.new(#131722, 0), tooltip="Each box is one strategy. Green = all boxes ticked or in a trade. Orange = some boxes ticked, watch it. Grey = not today or done. Hover a box for its checklist.\n✓ met · ✗ not met · … waiting for its time")
    live = not na(adr10) and not na(rOpen) and inRTH
    mvN = live ? (close - rOpen) / adr10 : 0.0
    fh = not na(ibH) and not na(ibL) ? ibH - ibL : 0.0
    effN = live and fh > 0 ? math.abs(close - rOpen) / fh : 0.0
    outN = live ? (close > rOpen ? close > pdh : close < pdl) : false
    gate = not dayStop
    // NEWS
    n1 = news830
    n2 = not na(nwF)
    nOk = n1 and n2 and nwN_ < 4 and nwLossRow < 3 and mnt < 570
    nTip = "NEWS 8:30 reversion\n" + ck(n1) + "CPI / PPI / NFP day\n" + (mnt < 509 ? "… " : ck(n2)) + "8:29 fair price set" + (n2 ? " (" + fmt(nwF) + ")" : "") + "\n" + (mnt < 510 ? "… " : ck(mnt < 570)) + "Window 8:30-9:29\n" + ck(nwLossRow < 3) + "Fewer than 3 losses in a row\n· Trigger: 5m candle back toward the fair price (displacement or break of structure)"
    // V4+
    v1 = biasSet and bias != 0 and bias == trendDir
    v2 = mnt >= 585 and mnt <= 780
    v3 = dr != 0 and dr == bias
    vN = (v1 ? 1 : 0) + (v2 ? 1 : 0) + (v3 ? 1 : 0) + (saw ? 1 : 0)
    vTip = "V4+ opening-range retest\n" + wt(not biasSet, ck(v1)) + "Daily trend (" + (trendDir > 0 ? "UP" : "DOWN") + ") and today's bias agree" + (biasSet ? " (bias " + (bias > 0 ? "LONG" : bias < 0 ? "SHORT" : "none") + ")" : " (set at 9:45)") + "\n" + wt(mnt < 585, ck(v2)) + "Window 9:45-13:00\n" + ck(v3) + "5m close outside the 9:30-9:45 range, bias side\n" + ck(saw) + "Price came back to retest the range edge\n· Trigger: strong candle away from the range"
    // D2
    d1 = not cpiOrFomc
    d2c = math.abs(mvN) >= d2Th
    dTip = "D2 10:30 continuation\n" + ck(d1) + "Not a CPI or FOMC day\n" + (mnt <= 629 ? (d2c ? "✓ " : "✗ ") + "Move from the open now " + str.tostring(mvN, "#.##") + " ADR (needs " + str.tostring(d2Th) + " at 10:29)" : (d2Pos != 0 or d2Done ? "✓ " : "✗ ") + "Moved " + str.tostring(d2Th) + " ADR by 10:29") + "\n" + wt(mnt < 629, ck(d2Pos != 0 or d2Done)) + "Entry at 10:30, stop at the open, out by 13:15"
    // TDP
    t1 = effN >= tdEff
    tTip = "TDP trend-day pullback\n" + (mnt <= 629 ? ck(t1) + "First hour efficiency now " + str.tostring(math.round(effN * 100)) + "% (needs " + str.tostring(math.round(tdEff * 100)) + "% at 10:29)\n" + ck(outN) + "Price outside the prior-day range" : ck(tdS != 0) + "Armed at 10:29 (clean first hour, outside prior-day range)") + "\n" + wt(mnt < 630, ck(tdS != 0 and mnt < 720)) + "Limit pullback (1/3 of first-hour range) before 12:00"
    // Pinball
    pTip = "Momentum Pinball\n" + ck(pinSide != 0) + "3-day RSI " + (na(rsi3) ? "n/a" : str.tostring(math.round(rsi3))) + (pinSide > 0 ? " oversold" : pinSide < 0 ? " overbought" : " (needs < 30 in an UP trend or > 70 in a DOWN trend)") + "\n" + wt(mnt < 630, ck(mnt >= 630 and mnt <= 900)) + "Window 10:30-15:00\n· Trigger: price breaks the first-hour " + (pinSide > 0 ? "high" : pinSide < 0 ? "low" : "high/low")
    // H2
    hTip = "H2 trend-day second entry (half size)\n" + wt(mnt < 629, ck(tdDir != 0)) + "Trend day: moved " + str.tostring(h2Th) + " ADR by 10:30\n" + wt(mnt < 629, ck(tdDir != 0 and tdDir == trendDir)) + "Same direction as the daily trend\n" + ck(h2N_ < h2Max) + "Fewer than " + str.tostring(h2Max) + " H2 trades today\n· Trigger: 5m pullback, second push back with the trend"
    // ORB
    oTip = "ORB retest (9:30-9:45 range: " + fmt(orL) + " - " + fmt(orH) + ")\n" + wt(mnt < 585, ck(mnt >= 585 and mnt < orbEnd)) + "Window 9:45-13:00\n" + ck(obArm != 0 or obDone) + "5m close outside the range" + (obArm > 0 ? " (UP)" : obArm < 0 ? " (DOWN)" : "") + "\n" + ck(obTouch or obDone) + "Retest of the range edge\n· Trigger: strong 5m candle away from the range\n· Stop: other side of the range · Target " + str.tostring(orbTgt) + "R · lock +1R at 1R"
    names = array.from("NEWS", "V4+", "D2", "TDP", "PIN", "H2", "ORB")
    tips = array.from(nTip, vTip, dTip, tTip, pTip, hTip, oTip)
    inT = array.from(nwPos != 0, v4Pos != 0, d2Pos != 0, tdPos != 0, pnPos != 0, h2Pos != 0, obPos != 0)
    full = array.from(nOk, v1 and v2 and v3 and saw, d1 and d2c and mnt <= 629, tdS != 0 and not tdDone and mnt < 720, pinSide != 0 and not pnDone and mnt >= 630 and mnt <= 900, tdDir != 0 and tdDir == trendDir and h2N_ < h2Max and mnt >= 630 and mnt <= 900, obArm != 0 and obTouch and not obDone and mnt < orbEnd)
    part = array.from(n1, v1 and not v4Done and mnt <= 780, d1 and math.abs(mvN) >= d2Th * 0.6 and mnt <= 629, effN >= tdEff * 0.7 and mnt <= 629, pinSide != 0 and not pnDone, tdDir != 0 and h2N_ < h2Max, obArm != 0 and not obDone)
    offT = array.from(not news830 or mnt >= 640, v4Done or mnt > 780 or (biasSet and not v1), d2Done or (mnt > 629 and d2Pos == 0) or cpiOrFomc, tdDone or (mnt > 629 and tdS == 0) or mnt >= 720, pinSide == 0 or pnDone or mnt > 900, (mnt > 629 and tdDir == 0) or h2N_ >= h2Max or mnt > 900, obDone or mnt >= orbEnd)
    en = array.from(useNW, useV4, useD2, useTD, usePin, useH2, useORB)
    cc = 1
    for k = 0 to 6
        if array.get(en, k)
            it = array.get(inT, k)
            st = it ? "IN TRADE" : not gate ? "STOP" : array.get(full, k) ? "READY" : array.get(offT, k) ? "off" : array.get(part, k) ? "watch" : "wait"
            col = it ? color.aqua : st == "READY" ? color.lime : st == "watch" ? color.orange : st == "STOP" ? color.red : color.gray
            table.cell(ckT, cc, 4, array.get(names, k) + (ckOpen ? " " + st : ""), text_color=col, text_size=size.normal, bgcolor=color.new(#131722, 0), tooltip=st + ": " + array.get(tips, k) + (gate ? "" : "\n\nSTOP DAY: no new trades"))
            cc += 1

// =====================================================================================
// INSIDE BAR (merged from the MNQ Inside Bar indicator: TradingView Basic allows 1 saved script)
// =====================================================================================
// MNQ Inside Bar (Oct 27 2026). Separate from the Playbook.
// Mother candle + inside candle(s), full-body breakout in the 2-of-3 higher-timeframe trend direction,
// stop on the other side of the mother candle, size from a fixed $ risk. One trade at a time.
// Exit: target 1.5R; once price reaches 1R the stop is locked at +1R (so a trade that reaches 1R banks 1R to 1.5R).
// Live tag tooltip updates every bar (P/L, best R so far, stop, nearby key levels) and flashes on each new event.
// Finished tags stay on the chart, faded, with the result: +1.5R / +1R (locked) / -1R (stop).

// ---------- inputs ----------
ib_gS = "Inside Bar"
ib_riskUsd   = input.float(200, "Risk per trade ($)", group=ib_gS)
ib_maxQty    = input.int(10, "Max contracts", group=ib_gS)
ib_rr        = input.float(1.5, "Max target (R)", step=0.25, group=ib_gS)
ib_lockAt    = input.float(1.0, "Lock profit at this R once reached (0 = off)", step=0.25, group=ib_gS)
ib_partPct   = input.int(0, "Contracts to take off at the lock level (%)", minval=0, maxval=100, step=25, group=ib_gS)
ib_needFull  = input.bool(true, "Full candle body must close outside the mother candle", group=ib_gS)
ib_withTrend = input.bool(true, "Only take breakouts in the trend direction", group=ib_gS)
ib_sessIn    = input.session("1800-1700", "Signal hours (New York time)", group=ib_gS)
ib_minStop   = input.float(5, "Min stop (pts)", group=ib_gS)
ib_maxStop   = input.float(80, "Max stop (pts)", group=ib_gS)
ib_expiry    = input.int(30, "Setup expires after N bars", group=ib_gS)
ib_showSkip  = input.bool(true, "Show skipped breakouts (gray, hover for reason)", group=ib_gS)
ib_daysBack  = input.int(3, "Draw signals for the last N days", minval=1, maxval=10, group=ib_gS)
ib_lvlNear   = input.float(0.35, "Warn when a key level is within this many R", step=0.05, group=ib_gS)
ib_tagDist   = input.float(1.5, "Tag distance from candles (x ATR)", step=0.25, group=ib_gS)
ib_gT = "Inside Bar trend (2 of 3 must agree)"
ib_tf1    = input.timeframe("15", "Trend timeframe 1", group=ib_gT)
ib_tf2    = input.timeframe("60", "Trend timeframe 2", group=ib_gT)
ib_tf3    = input.timeframe("240", "Trend timeframe 3", group=ib_gT)
ib_emaLen = input.int(21, "EMA length", group=ib_gT)
ib_showTrend = input.bool(true, "Show trend banner (top right)", group=ib_gT)

ib_pv   = syminfo.pointvalue
ib_tick = syminfo.mintick
ib_tz   = "America/New_York"
ib_fmtP(ib_x) => str.tostring(ib_x, format.mintick)
ib_fmtR(ib_x) => str.tostring(ib_x, "+0.0#;-0.0#") + "R"

// ---------- trend: close vs EMA on 3 higher timeframes, previous closed bar (no repaint) ----------
ib_fDir() => close > ta.ema(close, ib_emaLen) ? 1 : -1
ib_d1 = request.security(syminfo.tickerid, ib_tf1, ib_fDir()[1], lookahead=barmerge.lookahead_on)
ib_d2 = request.security(syminfo.tickerid, ib_tf2, ib_fDir()[1], lookahead=barmerge.lookahead_on)
ib_d3 = request.security(syminfo.tickerid, ib_tf3, ib_fDir()[1], lookahead=barmerge.lookahead_on)
ib_trend = ib_d1 + ib_d2 + ib_d3 > 0 ? 1 : -1

ib_arrowTxt(ib_d) => ib_d > 0 ? "▲" : "▼"
ib_dirCol(ib_d) => ib_d > 0 ? color.lime : color.red
var table ib_tt = table.new(position.top_right, 2, 1, bgcolor=color.new(color.black, 20), border_width=0)
if ib_showTrend and barstate.islast
    ib_agree = math.abs(ib_d1 + ib_d2 + ib_d3) == 3 ? "3/3" : "2/3"
    table.cell(ib_tt, 0, 0, "TREND " + ib_arrowTxt(ib_trend) + (ib_trend > 0 ? " UP " : " DOWN ") + ib_agree + (ib_trend > 0 ? " · LONGS ONLY" : " · SHORTS ONLY"), text_color=color.black, bgcolor=color.new(ib_dirCol(ib_trend), ib_agree == "3/3" ? 0 : 35), text_size=size.normal, tooltip="Close vs EMA21 on the last closed 15m / 60m / 240m candle. 2 of 3 must agree.\n3/3 = strong trend, 2/3 = weaker, be pickier.\nDo not take trades against this direction.")
    table.cell(ib_tt, 1, 0, ib_tf1 + ib_arrowTxt(ib_d1) + " " + ib_tf2 + ib_arrowTxt(ib_d2) + " " + ib_tf3 + ib_arrowTxt(ib_d3), text_color=color.new(color.white, 20), text_size=size.small)

// ---------- key levels: prior session (18:00-17:00) high/low/close + current session high/low ----------
var float ib_pH = na
var float ib_pL = na
var float ib_pC = na
var float ib_cH = na
var float ib_cL = na
ib_newS = hour(time, ib_tz) == 18 and hour(time[1], ib_tz) != 18
if ib_newS
    ib_pH := ib_cH
    ib_pL := ib_cL
    ib_pC := close[1]
    ib_cH := high
    ib_cL := low
else
    ib_cH := na(ib_cH) ? high : math.max(ib_cH, high)
    ib_cL := na(ib_cL) ? low : math.min(ib_cL, low)
ib_sessHi = ib_cH[1]
ib_sessLo = ib_cL[1]

// nearest key level between price and the target, in the trade direction
ib_levelAhead(int ib_d, float ib_px, float ib_tgt) =>
    string ib_nm = ""
    float ib_best = na
    ib_vals = array.from(ib_pH, ib_pL, ib_pC, ib_sessHi, ib_sessLo)
    ib_names = array.from("PDH", "PDL", "PDC", "session high", "session low")
    for ib_k = 0 to 4
        ib_v = array.get(ib_vals, ib_k)
        if not na(ib_v) and (ib_v - ib_px) * ib_d > 0 and (ib_v - ib_tgt) * ib_d < 0
            if na(ib_best) or math.abs(ib_v - ib_px) < math.abs(ib_best - ib_px)
                ib_best := ib_v
                ib_nm := array.get(ib_names, ib_k)
    [ib_nm, ib_best]

// ---------- state ----------
ib_inSess = not na(time(timeframe.period, ib_sessIn, ib_tz))
ib_recent = time > timenow - ib_daysBack * 86400000
ib_atr14 = ta.atr(14)
ib_tagY(int ib_d) => ib_d > 0 ? ta.lowest(low, 3) - ib_atr14 * ib_tagDist : ta.highest(high, 3) + ib_atr14 * ib_tagDist
ib_font0 = font.family_monospace

var bool  ib_armed = false
var float ib_mbH = na
var float ib_mbL = na
var int   ib_mbBar = 0
var int   ib_tDir = 0
var float ib_tS = na
var float ib_tT = na
var float ib_tE = na
var float ib_tR = na
var int   ib_tQ = 0
var bool  ib_locked = false
var float ib_mfe = 0.0
var box   ib_bx = na
var line  ib_lE = na
var line  ib_lS = na
var line  ib_lT = na
var line  ib_l1 = na
var label ib_lb = na
var line  ib_lC = na
varip int    ib_flash = 0
varip string ib_lastEvt = ""

ib_yUp = ib_tagY(1)
ib_yDn = ib_tagY(-1)
ib_longSig = false
ib_shortSig = false
string ib_evt = ""

ib_q1Of(int ib_q) => math.min(ib_q, math.round(ib_q * ib_partPct / 100.0))
ib_planTxt(int ib_q) =>
    ib_q1 = ib_q1Of(ib_q)
    ib_q2 = ib_q - ib_q1
    "\nPLAN (" + str.tostring(ib_q) + " MNQ): at " + ib_fmtR(ib_lockAt) + " (" + ib_fmtP(ib_tE + ib_tDir * ib_lockAt * ib_tR) + ") " + (ib_q1 > 0 ? "close " + str.tostring(ib_q1) + ", " : "") + "move stop to " + ib_fmtR(ib_lockAt) + " on " + (ib_q1 > 0 ? "the other " + str.tostring(ib_q2) : "all " + str.tostring(ib_q)) + "\n                at " + ib_fmtR(ib_rr) + " (" + ib_fmtP(ib_tT) + ") close " + str.tostring(ib_q2)
ib_liveTip(string ib_state, string ib_warn) =>
    ib_nowR = (close - ib_tE) * ib_tDir / ib_tR
    (ib_tDir > 0 ? "IB LONG " : "IB SHORT ") + str.tostring(ib_tQ) + " MNQ | " + ib_state + "\nNow " + ib_fmtP(close) + "  " + ib_fmtR(ib_nowR) + "  ($" + str.tostring(math.round((close - ib_tE) * ib_tDir * ib_tQ * ib_pv)) + ")\nBest so far " + ib_fmtR(ib_mfe) + "\nEntry " + ib_fmtP(ib_tE) + "\nStop " + ib_fmtP(ib_tS) + (ib_locked ? "  (locked at " + ib_fmtR(ib_lockAt) + ")" : "  (-1R)") + "\nTarget " + ib_fmtP(ib_tT) + "  (" + ib_fmtR(ib_rr) + ")" + ib_planTxt(ib_tQ) + (ib_warn != "" ? "\n⚠ " + ib_warn : "")

ib_finish(float ib_res0, string ib_why) =>
    ib_q1 = ib_q1Of(ib_tQ)
    ib_res = ib_locked and ib_q1 > 0 ? (ib_q1 * ib_lockAt + (ib_tQ - ib_q1) * ib_res0) / ib_tQ : ib_res0
    ib_c = ib_res > 0 ? color.lime : color.red
    line.delete(ib_lE)
    line.delete(ib_lS)
    line.delete(ib_lT)
    line.delete(ib_l1)
    box.set_right(ib_bx, bar_index)
    box.set_bgcolor(ib_bx, color.new(ib_c, 95))
    box.set_border_color(ib_bx, color.new(ib_c, 75))
    label.set_text(ib_lb, ib_arrowTxt(ib_tDir) + " " + str.tostring(ib_tQ) + "  " + ib_fmtR(ib_res))
    label.set_color(ib_lb, color.new(ib_c, 65))
    label.set_textcolor(ib_lb, color.new(color.white, 10))
    label.set_size(ib_lb, size.small)
    line.set_color(ib_lC, color.new(ib_c, 75))
    label.set_tooltip(ib_lb, (ib_tDir > 0 ? "IB LONG " : "IB SHORT ") + str.tostring(ib_tQ) + " MNQ | CLOSED: " + ib_why + "\nResult " + ib_fmtR(ib_res) + "  ($" + str.tostring(math.round(ib_res * ib_tR * ib_tQ * ib_pv)) + ")\nBest reached " + ib_fmtR(ib_mfe) + "\nEntry " + ib_fmtP(ib_tE) + "  Exit " + ib_fmtP(ib_tE + ib_tDir * ib_res0 * ib_tR) + (ib_locked and ib_q1 > 0 ? "\n" + str.tostring(ib_q1) + " closed at " + ib_fmtR(ib_lockAt) + ", " + str.tostring(ib_tQ - ib_q1) + " at " + ib_fmtR(ib_res0) : ""))

// ---------- 1) manage the open signal ----------
if ib_tDir != 0
    ib_hitS = ib_tDir > 0 ? low <= ib_tS : high >= ib_tS
    ib_hitT = ib_tDir > 0 ? high >= ib_tT : low <= ib_tT
    if ib_hitS
        ib_res = (ib_tS - ib_tE) * ib_tDir / ib_tR
        ib_finish(ib_res, ib_locked ? "profit lock hit" : "stopped out")
        ib_evt := "IB closed " + ib_fmtR(ib_res) + (ib_locked ? " (lock)" : " (stop)")
        ib_tDir := 0
    else if ib_hitT
        ib_finish(ib_rr, "target hit")
        ib_evt := "IB target hit " + ib_fmtR(ib_rr)
        ib_tDir := 0
    else
        ib_fav = (ib_tDir > 0 ? high - ib_tE : ib_tE - low) / ib_tR
        ib_mfe := math.max(ib_mfe, ib_fav)
        if ib_lockAt > 0 and not ib_locked and ib_fav >= ib_lockAt
            ib_locked := true
            ib_tS := ib_tE + ib_tDir * ib_lockAt * ib_tR
            line.set_y1(ib_lS, ib_tS)
            line.set_y2(ib_lS, ib_tS)
            line.set_color(ib_lS, color.new(color.lime, 20))
            line.delete(ib_l1)
            ib_l1 := na
            ib_evt := "IB reached " + ib_fmtR(ib_lockAt) + ": stop locked at " + ib_fmtP(ib_tS)
        [ib_nm, ib_lv] = ib_levelAhead(ib_tDir, close, ib_tT)
        ib_warn = ""
        if ib_nm != "" and math.abs(ib_lv - close) / ib_tR <= ib_lvlNear
            ib_warn := ib_nm + " " + ib_fmtP(ib_lv) + " is " + str.tostring(math.abs(ib_lv - close) / ib_tR, "0.0#") + "R ahead: possible " + (ib_tDir > 0 ? "resistance" : "support")
            if ib_evt == ""
                ib_evt := "IB: " + ib_nm + " ahead at " + ib_fmtP(ib_lv)
        ib_backIn = close < ib_mbH and close > ib_mbL
        if ib_backIn
            ib_warn := (ib_warn != "" ? ib_warn + "\n⚠ " : "") + "Closed back inside the mother candle: setup weakening"
            if ib_evt == ""
                ib_evt := "IB: closed back inside the box"
        ib_state = ib_locked ? "LOCKED " + ib_fmtR(ib_lockAt) : ib_backIn ? "WEAK" : "LIVE"
        box.set_right(ib_bx, bar_index)
        line.set_x2(ib_lE, bar_index)
        line.set_x2(ib_lS, bar_index)
        line.set_x2(ib_lT, bar_index)
        line.set_x2(ib_l1, bar_index)
        label.set_tooltip(ib_lb, ib_liveTip(ib_state, ib_warn))
        label.set_color(ib_lb, color.new(ib_backIn ? color.orange : ib_tDir > 0 ? color.lime : color.red, 0))

// ---------- 2) breakout of the armed mother candle ----------
if ib_armed
    ib_bodyLo = math.min(open, close)
    ib_bodyHi = math.max(open, close)
    ib_upOut = ib_needFull ? ib_bodyLo > ib_mbH : close > ib_mbH
    ib_dnOut = ib_needFull ? ib_bodyHi < ib_mbL : close < ib_mbL
    if ib_upOut or ib_dnOut
        ib_side = ib_upOut ? 1 : -1
        ib_armed := false
        ib_e = close
        ib_s = ib_side > 0 ? ib_mbL - ib_tick : ib_mbH + ib_tick
        ib_r = math.abs(ib_e - ib_s)
        ib_q = math.min(ib_maxQty, math.floor(ib_riskUsd / (ib_r * ib_pv)))
        ib_ok = useIB and (not ib_withTrend or ib_side == ib_trend) and ib_inSess and ib_tDir == 0 and ib_r >= ib_minStop and ib_r <= ib_maxStop and ib_q >= 1
        if ib_ok
            ib_t = ib_e + ib_side * ib_rr * ib_r
            ib_tDir := ib_side
            ib_tS := ib_s
            ib_tT := ib_t
            ib_tE := ib_e
            ib_tR := ib_r
            ib_tQ := ib_q
            ib_locked := false
            ib_mfe := 0.0
            ib_c = ib_side > 0 ? color.lime : color.red
            ib_bx := box.new(ib_mbBar, ib_mbH, bar_index, ib_mbL, border_color=color.new(ib_c, 30), border_width=1, border_style=line.style_dashed, bgcolor=color.new(ib_c, 88))
            ib_lE := line.new(bar_index, ib_e, bar_index + 1, ib_e, color=color.new(color.white, 40), width=1)
            ib_lS := line.new(bar_index, ib_s, bar_index + 1, ib_s, color=color.new(color.red, 20), style=line.style_dashed, width=1)
            ib_lT := line.new(bar_index, ib_t, bar_index + 1, ib_t, color=color.new(color.lime, 20), style=line.style_dashed, width=1)
            ib_l1 := ib_lockAt > 0 ? line.new(bar_index, ib_e + ib_side * ib_lockAt * ib_r, bar_index + 1, ib_e + ib_side * ib_lockAt * ib_r, color=color.new(color.lime, 55), style=line.style_dotted, width=1) : na
            ib_ly = ib_side > 0 ? ib_yUp : ib_yDn
            ib_lC := line.new(bar_index, ib_side > 0 ? low : high, bar_index, ib_ly, color=color.new(ib_c, 50), style=line.style_dotted, width=1)
            ib_lb := label.new(bar_index, ib_ly, ib_arrowTxt(ib_side) + " " + str.tostring(ib_q), style=ib_side > 0 ? label.style_label_up : label.style_label_down, color=color.new(ib_c, 0), textcolor=color.black, size=size.normal, text_font_family=ib_font0)
            label.set_tooltip(ib_lb, ib_liveTip("NEW", "") + "\nOrder panel: Stop loss " + str.tostring(math.round(ib_r / ib_tick)) + " ticks, Take profit " + str.tostring(math.round(ib_rr * ib_r / ib_tick)) + " ticks\nTrend " + (ib_trend > 0 ? "UP" : "DOWN") + " (" + ib_tf1 + "/" + ib_tf2 + "/" + ib_tf3 + ")")
            ib_evt := "IB " + (ib_side > 0 ? "LONG " : "SHORT ") + str.tostring(ib_q) + " at " + ib_fmtP(ib_e) + ", stop " + ib_fmtP(ib_s) + ", target " + ib_fmtP(ib_t)
            ib_longSig := ib_side > 0
            ib_shortSig := ib_side < 0
        else if useIB and ib_showSkip and ib_inSess
            ib_why = (ib_withTrend and ib_side != ib_trend) ? "against the trend (" + ib_tf1 + ib_arrowTxt(ib_d1) + " " + ib_tf2 + ib_arrowTxt(ib_d2) + " " + ib_tf3 + ib_arrowTxt(ib_d3) + ")" : ib_tDir != 0 ? "another IB trade is still open" : ib_r > ib_maxStop ? "stop too big (" + ib_fmtP(ib_r) + " pts > " + str.tostring(ib_maxStop) + ")" : ib_r < ib_minStop ? "stop too small (" + ib_fmtP(ib_r) + " pts)" : "risk too big for 1 MNQ at $" + str.tostring(ib_riskUsd)
            ib_sy = ib_side > 0 ? ib_yUp : ib_yDn
            label.new(bar_index, ib_sy, ib_side > 0 ? "▲" : "▼", style=label.style_none, textcolor=color.new(color.gray, 25), size=size.normal, text_font_family=ib_font0, tooltip="IB " + (ib_side > 0 ? "LONG" : "SHORT") + " breakout SKIPPED: " + ib_why + "\nMother candle " + ib_fmtP(ib_mbH) + " / " + ib_fmtP(ib_mbL) + ", breakout close " + ib_fmtP(ib_e) + ", stop would be " + ib_fmtP(ib_r) + " pts")
    else if bar_index - ib_mbBar > ib_expiry
        ib_armed := false

// ---------- 3) new mother candle: this bar sits inside the previous one ----------
ib_isInside = high <= high[1] and low >= low[1]
if useIB and ib_recent and not ib_armed and ib_tDir == 0 and ib_isInside and not ib_longSig and not ib_shortSig
    ib_armed := true
    ib_mbH := high[1]
    ib_mbL := low[1]
    ib_mbBar := bar_index - 1

// ---------- 4) live events: flash the tag and fire an alert ----------
if barstate.isrealtime and ib_evt != "" and ib_evt != ib_lastEvt
    ib_lastEvt := ib_evt
    ib_flash := 10
    alert(ib_evt + " (" + syminfo.ticker + ")", alert.freq_once_per_bar)
if barstate.isrealtime and ib_flash > 0 and ib_tDir != 0
    ib_flash -= 1
    label.set_color(ib_lb, ib_flash % 2 == 0 ? color.new(color.yellow, 0) : color.new(ib_tDir > 0 ? color.lime : color.red, 0))

alertcondition(ib_longSig, "IB long", "IB breakout LONG on {{ticker}}")
alertcondition(ib_shortSig, "IB short", "IB breakout SHORT on {{ticker}}")
