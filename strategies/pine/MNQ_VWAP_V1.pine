//@version=5
strategy("MNQ VWAP V1", overlay=true, initial_capital=25000, commission_type=strategy.commission.cash_per_contract, commission_value=2.37, slippage=1, margin_long=0, margin_short=0, max_bars_back=500)

// Session VWAP from 9:30. Three setups, pick one:
//  Bounce: trend side of VWAP, pullback touches VWAP, signal candle closes back on the trend side -> stop order beyond it
//  Cross:  a strong candle closes through VWAP with momentum -> stop order beyond it (trade the cross)
//  Failed cross: a candle closes through VWAP, the next candle closes back -> trade the failure
mode     = input.string("Bounce", "Setup", options=["Bounce", "Cross", "Failed cross"])
useEma   = input.bool(true, "Trend filter: EMA 21 slope agrees")
momMult  = input.float(1.2, "Momentum candle: range >= x avg range (Cross only)")
stopMode = input.string("Pullback", "Stop at", options=["Pullback", "Signal bar", "VWAP"])
bufT     = input.int(4, "Stop buffer (ticks)")
minStopT = input.int(16, "Min stop (ticks)")
maxStopP = input.float(80, "Max stop (points)")
tgtMode  = input.string("R", "Target", options=["R", "Prior day high/low", "TP1 + runner"])
tgtR     = input.float(2.0, "Target (R multiple)")
tp1R     = input.float(1.0, "TP1 (R) for TP1 + runner")
riskUSD  = input.float(300, "Risk per trade ($)")
maxQty   = input.int(20, "Max contracts")
firstEnt = input.int(945, "First entry (HHMM ET)")
lastEnt  = input.int(1300, "Last entry (HHMM ET)")
maxTrades = input.int(3, "Max trades per day")
sigFrac  = input.float(0.5, "Signal bar: close in top/bottom fraction")
minBody  = input.float(0.3, "Signal bar: min body / range")
comm     = input.float(2.37, "Commission per contract per side (sizing)")

tz   = "America/New_York"
m    = hour(time, tz) * 60 + minute(time, tz)
tick = syminfo.mintick
pv   = syminfo.pointvalue
flatM = 15 * 60 + 55
firstM = int(firstEnt / 100) * 60 + firstEnt % 100
lastM  = int(lastEnt / 100) * 60 + lastEnt % 100
inRTH  = m >= 9 * 60 + 30 and m < 16 * 60
newDay = ta.change(dayofmonth(time, tz)) != 0

// session VWAP (RTH only)
var float pvSum = 0.0
var float vSum = 0.0
var int dayTrades = 0
var float rthHi = na
var float rthLo = na
var float pdH = na
var float pdL = na
if m == 9 * 60 + 30
    pvSum := 0.0
    vSum := 0.0
    dayTrades := 0
if newDay and not na(rthHi)
    pdH := rthHi
    pdL := rthLo
    rthHi := na
    rthLo := na
if inRTH
    pvSum += hlc3 * volume
    vSum += volume
    rthHi := na(rthHi) ? high : math.max(rthHi, high)
    rthLo := na(rthLo) ? low : math.min(rthLo, low)
vwap = vSum > 0 ? pvSum / vSum : na
ema = ta.ema(close, 21)
avgR = ta.sma(high - low, 20)
upT = not useEma or ema > ema[3]
dnT = not useEma or ema < ema[3]

pos = strategy.position_size
if pos != 0 and nz(pos[1]) == 0
    dayTrades += 1

rng  = high - low
bull = close > open and rng > 0 and (close - low) >= sigFrac * rng and math.abs(close - open) >= minBody * rng
bear = close < open and rng > 0 and (high - close) >= sigFrac * rng and math.abs(close - open) >= minBody * rng
canTrade = inRTH and m >= firstM and m <= lastM and pos == 0 and dayTrades < maxTrades and not na(vwap) and m > 9 * 60 + 30

// pullback tracking for the bounce: lowest low since price was last well above VWAP
var float pbLow = na
var float pbHigh = na
if not na(vwap)
    pbLow := low <= vwap ? (na(pbLow) ? low : math.min(pbLow, low)) : (close > vwap and low > vwap ? na : pbLow)
    pbHigh := high >= vwap ? (na(pbHigh) ? high : math.max(pbHigh, high)) : (close < vwap and high < vwap ? na : pbHigh)

longSig = false
shortSig = false
if mode == "Bounce"
    longSig := upT and close > vwap and low <= vwap and bull
    shortSig := dnT and close < vwap and high >= vwap and bear
else if mode == "Cross"
    longSig := upT and close > vwap and close[1] <= vwap[1] and bull and rng >= momMult * avgR
    shortSig := dnT and close < vwap and close[1] >= vwap[1] and bear and rng >= momMult * avgR
else
    longSig := close > vwap and close[1] < vwap[1] and close[2] >= vwap[2] and bull
    shortSig := close < vwap and close[1] > vwap[1] and close[2] <= vwap[2] and bear

placedL = false
placedS = false
if canTrade and longSig
    e   = high + tick
    stp = stopMode == "Signal bar" ? low - bufT * tick : stopMode == "VWAP" ? vwap - bufT * tick : math.min(low, nz(pbLow, low)) - bufT * tick
    r   = math.max(e + tick - stp, minStopT * tick)
    q   = math.min(maxQty, math.floor(riskUSD / (r * pv + 2 * comm)))
    tgt = tgtMode == "Prior day high/low" and not na(pdH) and pdH > e + tick + r ? pdH - tick : e + tick + tgtR * r
    if r <= maxStopP and q >= 1
        strategy.entry("L", strategy.long, qty=q, stop=e)
        if tgtMode == "TP1 + runner" and q >= 2
            strategy.exit("XL1", "L", qty=math.floor(q / 2), stop=e + tick - r, limit=e + tick + tp1R * r)
            strategy.exit("XL2", "L", stop=e + tick - r, limit=tgt)
        else
            strategy.exit("XL", "L", stop=e + tick - r, limit=tgt)
        placedL := true
if canTrade and shortSig
    e   = low - tick
    stp = stopMode == "Signal bar" ? high + bufT * tick : stopMode == "VWAP" ? vwap + bufT * tick : math.max(high, nz(pbHigh, high)) + bufT * tick
    r   = math.max(stp - (e - tick), minStopT * tick)
    q   = math.min(maxQty, math.floor(riskUSD / (r * pv + 2 * comm)))
    tgt = tgtMode == "Prior day high/low" and not na(pdL) and pdL < e - tick - r ? pdL + tick : e - tick - tgtR * r
    if r <= maxStopP and q >= 1
        strategy.entry("S", strategy.short, qty=q, stop=e)
        if tgtMode == "TP1 + runner" and q >= 2
            strategy.exit("XS1", "S", qty=math.floor(q / 2), stop=e - tick + r, limit=e - tick - tp1R * r)
            strategy.exit("XS2", "S", stop=e - tick + r, limit=tgt)
        else
            strategy.exit("XS", "S", stop=e - tick + r, limit=tgt)
        placedS := true
if not placedL
    strategy.cancel("L")
if not placedS
    strategy.cancel("S")
if m >= flatM and m < 16 * 60 + 30
    strategy.close_all(comment="EOD", immediately=true)

plot(inRTH ? vwap : na, "VWAP", color=color.yellow, linewidth=2)
plot(ema, "EMA 21", color=color.new(color.white, 40))
plotshape(placedL, "Long setup", shape.triangleup, location.belowbar, color.teal, size=size.tiny)
plotshape(placedS, "Short setup", shape.triangledown, location.abovebar, color.maroon, size=size.tiny)
